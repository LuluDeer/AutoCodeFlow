{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "plugins": [],
  "packages": {
    "packages/autocodeflow-node-sdk": {
      "release-type": "node",
      "component": "autocodeflow-sdk",
      "extra-files": [
        "/packages/docs-site/sdk-node.md",
        "/packages/docs-site/sdk-python.md",
        "/packages/docs-site/getting-started.md",
        "/packages/docs-site/release.md",
        "/packages/docs-site/index.md"
      ]
    },
    "packages/mcp-server": {
      "release-type": "node",
      "component": "autocodeflow-mcp-server"
    },
    "packages/autoflow-sdk": {
      "release-type": "python",
      "component": "autoflow-sdk",
      "extra-files": [
        "autoflow_sdk/__init__.py"
      ]
    },
    "packages/acf-cli": {
      "release-type": "node",
      "component": "autocodeflow-cli"
    },
    "packages/autocodeflow-http": {
      "release-type": "python",
      "component": "autocodeflow-http",
      "extra-files": [
        "autocodeflow_http/__init__.py"
      ]
    },
    "packages/autocodeflow-ai": {
      "release-type": "python",
      "component": "autocodeflow-ai",
      "extra-files": [
        "autocodeflow_ai/__init__.py"
      ]
    },
    "packages/autocodeflow-db": {
      "release-type": "python",
      "component": "autocodeflow-db",
      "extra-files": [
        "autocodeflow_db/__init__.py"
      ]
    },
    "packages/autocodeflow-notify": {
      "release-type": "python",
      "component": "autocodeflow-notify",
      "extra-files": [
        "autocodeflow_notify/__init__.py"
      ]
    }
  },
  "linked-versions": [
    {
      "groupName": "autocodeflow",
      "components": [
        "autocodeflow-sdk",
        "autocodeflow-mcp-server",
        "autocodeflow-cli",
        "autoflow-sdk"
      ]
    },
    {
      "groupName": "autocodeflow-py-libs",
      "components": [
        "autocodeflow-http",
        "autocodeflow-ai",
        "autocodeflow-db",
        "autocodeflow-notify"
      ]
    }
  ]
}
