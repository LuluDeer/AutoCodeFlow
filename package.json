    "check:response-schema:report": "node scripts/check-openapi-response-schema.mjs --report",
    "check:response-schema:update": "node scripts/check-openapi-response-schema.mjs --update",
    "check:desktop-bundle-drift": "node scripts/check-desktop-bundle-drift.mjs",
    "check:desktop-bundle-drift:selftest": "node scripts/check-desktop-bundle-drift.mjs --selftest",
