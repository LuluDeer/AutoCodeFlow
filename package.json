{
  "name": "autocodeflow-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "AutoCodeFlow monorepo root — unified command entry (per-app installs remain independent; no workspace hoisting by design, see ARCH-20)",
  "scripts": {
    "test:api": "cd apps/admin-api && npx jest",
    "test:node": "cd apps/executor-node && npx jest",
    "test:python": "cd apps/executor-python && python -m pytest -q",
    "test:web": "cd apps/admin-web && npx vitest run",
    "test:cli": "cd packages/acf-cli && npx vitest run",
    "test:mcp": "cd packages/mcp-server && npx vitest run",
    "test:pypi": "cd apps/registry-pypi && python -m pytest -q",
    "test:sdk-py": "cd packages/autoflow-sdk && python -m pytest -q",
    "test:node-sdk": "cd packages/autocodeflow-node-sdk && npx jest",
    "test:lib-http": "cd packages/autocodeflow-http && python -m pytest tests -q",
    "test:lib-ai": "cd packages/autocodeflow-ai && python -m pytest tests -q",
    "test:lib-notify": "cd packages/autocodeflow-notify && python -m pytest tests -q",
    "test:lib-db": "cd packages/autocodeflow-db && python -m pytest tests -q",
    "test:desktop": "cd apps/executor-desktop && npm run test:main && npm run test:renderer",
    "test:registry-npm": "node scripts/registry-npm-config.selftest.mjs",
    "test:private-registry": "node scripts/bug18-private-registry-selftest.mjs --dry-run",
    "test:private-registry:live": "node scripts/bug18-private-registry-selftest.mjs",
    "test:private-registry:dispatch": "node scripts/bug18-private-registry-dispatch-selftest.mjs",
    "test:arch31-multi-instance": "node scripts/arch31-multi-instance-selftest.mjs",
    "test:all": "npm run test:api && npm run test:node && npm run test:python && npm run test:web && npm run test:cli && npm run test:mcp && npm run test:pypi && npm run test:sdk-py && npm run test:node-sdk",
    "typecheck:api": "cd apps/admin-api && npx tsc --noEmit -p tsconfig.json",
    "typecheck:node": "cd apps/executor-node && npx tsc --noEmit",
    "typecheck:cli": "cd packages/acf-cli && npx tsc --noEmit",
    "typecheck:mcp": "cd packages/mcp-server && npx tsc --noEmit",
    "typecheck:node-sdk": "cd packages/autocodeflow-node-sdk && npx tsc --noEmit",
    "typecheck:desktop": "cd apps/executor-desktop && npx tsc -p tsconfig.json --noEmit",
    "typecheck:web": "cd apps/admin-web && npx tsc -b",
    "typecheck:all": "npm run typecheck:api && npm run typecheck:node && npm run typecheck:cli && npm run typecheck:mcp && npm run typecheck:node-sdk && npm run typecheck:desktop && npm run typecheck:web",
    "lint:api": "cd apps/admin-api && npx eslint src",
    "lint:web": "cd apps/admin-web && npm run lint",
    "lint:node": "echo 'executor-node has no eslint config (ESLint v9 needs eslint.config.*) — skipped, see ARCH-20 verification notes'",
    "lint:all": "npm run lint:api && npm run lint:web",
    "build:web": "cd apps/admin-web && npm run build",
    "build:node": "cd apps/executor-node && npm run build",
    "build:node-sdk": "cd packages/autocodeflow-node-sdk && npm run build",
    "build:cli": "cd packages/acf-cli && npm run build",
    "build:mcp": "cd packages/mcp-server && npm run build",
    "build:desktop": "cd apps/executor-desktop && npm run build",
    "build:docs-site": "cd packages/docs-site && npm run build",
    "bundle:executor": "cd apps/executor-desktop && bash scripts/bundle-executor.sh",
    "openapi:export": "cd apps/admin-api && npm run swagger:export",
    "gen:api-types": "cd apps/admin-web && npm run gen:api-types",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:seed:selftest": "node scripts/demo-seed.selftest.mjs",
    "demo:failure:seed": "node scripts/demo-failure-seed.mjs",
    "demo:failure:seed:selftest": "node scripts/demo-failure-seed.selftest.mjs",
    "load-test": "node scripts/load-test.mjs",
    "bench:micro": "node scripts/micro-benchmark.mjs",
    "bench:micro:selftest": "node scripts/micro-benchmark.selftest.mjs"
  }
}
