    "test:sdk-py": "cd packages/autoflow-sdk && python -m pytest -q",
    "test:node-sdk": "cd packages/autocodeflow-node-sdk && npx jest",
    "test:lib-http": "cd packages/autocodeflow-http && python -m pytest tests -q",
    "test:lib-ai": "cd packages/autocodeflow-ai && python -m pytest tests -q",
    "test:lib-notify": "cd packages/autocodeflow-notify && python -m pytest tests -q",
