    "check:user-facing-language": "node scripts/check-user-facing-language.mjs",
    "check:user-facing-language:selftest": "node scripts/check-user-facing-language.mjs --selftest",
    "check:user-facing-language:report": "node scripts/check-user-facing-language.mjs --report",
    "check:error-i18n": "node scripts/check-error-i18n.mjs",
