# OpenAPI 导出产物（ARCH-23）……产物**入库**：CI api-types-drift job 以
# git diff 校验「重新导出 vs 库内版本」逐字节一致，所以 openapi.json 与
# 生成的 api-types.ts 都必须跟踪；忽略会让 CI 永远看不到 drift。
# 此前忽略 + admin-web 生成物入库的裁定见 ARCH-23 交付注记。
!apps/admin-api/openapi.json

# 根目录全量 e2e 基线（W-12 已入库：29 例版，test#16 已同步 W-13 修复）；.cjs 本地编译副本仍忽略
/e2e-full.spec.cjs
/playwright.e2e.config.cjs

# 截图和图片
*.png
*.jpg
*.jpeg
# 但打包资源图标必须入库（W-16：electron-builder 图标源 + 托盘图标，缺失则 Windows 打包回退默认 Electron 图标）
!apps/executor-desktop/assets/*.png

# 上传目录
apps/admin-api/uploads/
 
# 宝塔部署配置（仅服务器本地维护，不入库）
apps/admin-api/.htaccess
report.*.json

# 混沌演练临时 env（含口令，勿入库）
.env.chaos

# F-19（DEEP_REVIEW 0ef3bbe）：executor-desktop 内嵌 executor-node 的 ncc bundle 出库。
# 产物（index.js / sourcemap-register.js / *.map，约 2.1MB）不再入库，由
# `npm run build:executor`（本地）或 CI desktop-* bundle job 打包前重打。
# 期望哈希跟踪在 apps/executor-desktop/executor-node-bundle.sha256（drift guard 把守）。
apps/executor-desktop/resources/executor-node/

# 随包分发的 uv 二进制（ACF_BUNDLE_UV=1 / ACF_UV_REQUIRED=1 时由
# scripts/bundle-executor.sh 拉取，单个约 59MB）。同 F-19 的理由：构建产物
# 不入库，随安装包一起出。注意此前只忽略了 executor-node/，uv 目录是**裸的**
# ——一旦有人跑过打包，59MB 二进制会被 git add 吞进仓库。
apps/executor-desktop/resources/uv/

dump.rdb

# AI 助手工作区记忆（会话上下文/长期约定，本地留存，不入库）
.workbuddy-ai/


# pytest 本地 basetemp（测试临时目录，不入库）
.pytmp/

