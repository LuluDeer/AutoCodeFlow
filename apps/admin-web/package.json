{
  "name": "admin-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "cross-env ANALYZE=true vite build",
    "lint": "eslint .",
    "lint:i18n": "node scripts/i18n-scan.mjs --selftest && node scripts/i18n-scan.mjs --check && node scripts/i18n-key-check.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:key-check": "node scripts/i18n-key-check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:agent": "playwright test --config=playwright.agent.config.ts",
    "test:e2e:deeplink": "playwright test --config=playwright.deeplink.config.ts",
    "verify:task-detail-ux": "node scripts/verify-task-detail-ux.mjs",
    "gen:api-types": "openapi-typescript ../admin-api/openapi.json -o src/types/generated/api-types.ts --default-non-nullable=false",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "i18next": "^27.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "js-yaml": "^4.3.2",
    "tmp": "^0.2.6",
    "dompurify": "^3.4.16",
    "uuid": "^11.1.1",
    "minimatch": "^11.0.4"
  }
}
