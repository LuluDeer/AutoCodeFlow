# ============================================================
# admin-web 环境变量配置
# 复制此文件为 .env 并填入实际值
# Vite 只将 VITE_ 前缀的变量暴露给浏览器端
# ============================================================

# API 地址（开发环境默认代理到 localhost:3105）
VITE_API_URL=http://localhost:3105

# 内部 API 地址（容器内 / SSR 请求用，留空则使用 VITE_API_URL）
VITE_API_URL_INTERNAL=http://localhost:3105

# 外部 API 地址（公网访问用，留空则使用 VITE_API_URL）
VITE_API_URL_EXTERNAL=

# 私有仓库（npm / PyPI）安装命令的基址（2026-10-23）
# 留空 = 与前端同源。这是**标准部署的正确值**：/pypi/ 与 /npm/ 两块反代挂在
# admin-web 的 nginx 上（apps/admin-web/nginx.conf），和 SPA 同一台主机。
# 只有下列形态才需要显式设置（填仓库反代的可达地址，如 https://registry.example.com）：
#   · 仓库反代另挂主机（前端 acf.example.com、仓库 registry.example.com）
#   · 前端由 CDN / 对象存储托管（前端域名下没有 nginx 反代）
# ⚠️ 不要填 admin-api 的地址——admin-api 不提供 /pypi、/npm 路由。
VITE_REGISTRY_BASE_URL=

# 应用标题
VITE_APP_TITLE=AutoCodeFlow

# 开发服务器端口
VITE_PORT=5176
