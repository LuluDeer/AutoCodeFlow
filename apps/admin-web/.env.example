# ============================================================
# admin-web 环境变量配置
# 复制此文件为 .env 并填入实际值
# Vite 只将 VITE_ 前缀的变量暴露给浏览器端
# ============================================================

# API 地址（开发环境默认代理到 localhost:3105）
VITE_API_URL=http://localhost:3105

# 内部 API 地址（容器内 / SSR 请求用，留空则使用 VITE_API_URL）
VITE_API_URL_INTERNAL=http://localhost:3105

# 外部 API 地址（公网访问用，留空则使用 VITE_API_URL）
VITE_API_URL_EXTERNAL=

# 应用标题
VITE_APP_TITLE=AutoCodeFlow

# 开发服务器端口
VITE_PORT=5173
