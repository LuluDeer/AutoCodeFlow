# ============================================================
# admin-web 环境变量配置
# 复制此文件为 .env 并填入实际值
# Vite 只将 VITE_ 前缀的变量暴露给浏览器端
# ============================================================

# 内部 API 地址（浏览器同源入口）
# 留空或 /api = 同源经 Vite dev proxy（开发）或 nginx 反代（部署）到后端；
# 后端全局 /api 前缀恒开（main.ts setGlobalPrefix('api')，无 env 开关），不可省略。
# 切勿填 http://localhost:3105 这类裸路径：浏览器会直接打 POST /auth/login → 404；
# http://admin-api:3105 还是浏览器不可解析的 Docker 内部服务名。
VITE_API_URL_INTERNAL=/api

# 外部 API 地址（公网直连用，留空则继续走同源 /api）
VITE_API_URL_EXTERNAL=

# 私有仓库（npm / PyPI）安装命令的基址（2026-10-23）
# 留空 = 与前端同源。这是**标准部署的正确值**：/pypi/ 与 /npm/ 两块反代挂在
# admin-web 的 nginx 上（apps/admin-web/nginx.conf），和 SPA 同一台主机。
# 只有下列形态才需要显式设置（填仓库反代的可达地址，如 https://registry.example.com）：
#   · 仓库反代另挂主机（前端 acf.example.com、仓库 registry.example.com）
#   · 前端由 CDN / 对象存储托管（前端域名下没有 nginx 反代）
# ⚠️ 不要填 admin-api 的地址——admin-api 不提供 /pypi、/npm 路由。
VITE_REGISTRY_BASE_URL=

# 应用标题
VITE_APP_TITLE=AutoCodeFlow

# 前端展示版本号（可选覆盖）。默认由构建期从仓库根 version.txt 注入主线版本，
# 仅在 release / 镜像构建需要指定不同版本时显式设置；留空 = 跟随 version.txt。
VITE_APP_VERSION=

# 开发服务器端口
VITE_PORT=5176
