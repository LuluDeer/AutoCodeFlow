# AutoFlow Admin Web 环境变量配置
# 复制此文件为 .env 并填入实际值

# API 地址（开发环境默认代理到 localhost:3001）
VITE_API_URL=http://localhost:3001

# 内部 API 地址（SSR / 服务端请求用）
VITE_API_URL_INTERNAL=http://localhost:3001

# 外部 API 地址（公网访问用，留空则使用 VITE_API_URL）
VITE_API_URL_EXTERNAL=

# 应用标题
VITE_APP_TITLE=AutoFlow

# 开发服务器端口
VITE_PORT=5173