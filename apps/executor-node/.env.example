# ============================================================
# executor-node 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 执行器身份 ----
# 实例名称，注册到 admin-api 时显示
APP_NAME=executor-node-1
# 监听端口
PORT=8002
# 执行器在内部网络的地址（admin-api 回调用）
EXECUTOR_ADDRESS=localhost:8002
# 执行器对外公网地址（留空则使用 EXECUTOR_ADDRESS）
EXECUTOR_ADDRESS_PUBLIC=

# ---- 派发模式（ARCH-32 / ADR-015 + ARCH-33 / ADR-016）----
# true = pull 模式：执行器主动长轮询 admin-api 领取任务与**控制面命令**
#   （部署/停止/卸载/配置热更新/终止执行/包更新），admin 无需反向连入。
#   公网中台 + 内网执行器（NAT）拓扑必须开启——push 模式下 admin 拨入内网
#   地址必然超时（生产实证："Failed to reach executor after 3 attempts:
#   timeout of 30000ms exceeded"）。
# false（默认）= push 模式：admin 反向 POST 到本执行器。
# 注意：控制面命令通道要求协议 v2（本版本已上报 PROTOCOL_VERSION=2）；
# 中台按 protocolVersion 决定是否下发 commands，旧中台/旧执行器行为不变。
EXECUTOR_PULL_MODE=false

# ---- Admin API 连接 ----
ADMIN_API_URL=http://localhost:3105
# 容器内访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_INTERNAL=
# 公网访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_EXTERNAL=
# 多 admin-api 地址，逗号分隔（高可用场景）
ADMIN_API_URLS=

# ---- 鉴权 ----
# 须与 admin-api EXECUTOR_SECRET 一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars
# 兼容旧版字段名（与 EXECUTOR_SECRET 二选一即可）
# EXECUTOR_SHARED_TOKEN=

# ---- 任务执行 ----
# 任务工作目录
WORK_DIR=/tmp/autocodeflow/tasks
# 最大并发任务数
MAX_CONCURRENT_TASKS=10
# 日志保留天数
LOG_RETENTION_DAYS=7

# ---- 私有包仓库 (可选) ----
# 私有 npm registry 地址（留空则使用 npmjs.com）
NPM_REGISTRY_URL=
# 私有 PyPI registry 地址（留空则使用 pypi.org）
PYTHON_REGISTRY_URL=

# ---- Python 解释器缓存池与多版本（python_task_multiversion）----
# executor-node 的 python 分支与 executor-python 对等：任务声明 runtimeVersion
# 时按声明版本获取解释器建 venv 运行；不声明版本且无依赖时保持既有行为
# （直接以宿主 python3 运行，逐字节不变）。
#
# uv 可执行文件路径（可选）。留空时按以下顺序自动解析：
#   1) 本变量显式指定；
#   2) PATH 中查找 uv；
#   3) 桌面端（executor-desktop）随包内置的 uv —— Electron 主进程会自动
#      注入 UV_BIN 指向 process.resourcesPath/uv/uv[.exe]，**无需手工配置**；
#   4) 都不可用 → 解释器清单为空；声明版本的任务明确失败
#      （分因 interpreter_unavailable，reason=uv_missing，消息指引安装 uv
#      或使用内置）；未声明版本的任务行为完全不变（向后兼容硬要求）。
UV_BIN=

# 解释器缓存池根目录（可选）。**留空时的默认值与 executor-python 不同**：
# 本执行器取 WORK_DIR 的**兄弟目录** `interpreters`（即 `path.resolve(WORK_DIR,
# '..', 'interpreters')`），而非固定的 /data/interpreters。
# ⚠ 与 executor-python 同约束：必须位于 WORK_DIR 之外，否则会被磁盘 TTL
#   清扫误删（解释器是可复用资产，删了要重新下载，离线环境永久不可恢复）。
#   compose 部署已显式设为 /data/interpreters（与 python 执行器共享同一卷）；
#   裸机/桌面端如需共享同一份解释器层，请把两边的本变量指向同一目录。
UV_PYTHON_INSTALL_DIR=

# 解释器下载镜像（可选，私有化模式 A）。留空 = 走 uv 默认下载源
# （Astral CDN / GitHub Releases，在线主路径）。
# 内网/无外网部署填内网镜像地址。仅 http(s)，且不得含 userinfo/query/fragment。
UV_PYTHON_INSTALL_MIRROR=

# 单次解释器下载的独立超时预算（秒，默认 300，D11），与任务剩余超时取较小者。
# 实测单版本首次下载约 13~17s；弱网现场可下调或上调。
# 取值越界不报错：钳到 [1, 86400]（避免手滑填 0 让每次下载立即超时）。
INTERPRETER_DOWNLOAD_TIMEOUT_SECONDS=300

# 解释器池体积红线（L-1 / NFR-15 / D12）。executor-node 现已实现与
# executor-python 对等的体积红线 + 引用感知 LRU 回收：
#   - 单版本目录超过 INTERPRETER_SINGLE_VERSION_MB 时尝试回收；
#   - 总池超过 INTERPRETER_TOTAL_GB 时按目录 mtime 升序回收最久未使用的版本；
#   - 任何仍被任务 venv（.venvs/*/pyvenv.cfg 的 home 指向）依赖的版本一律跳过，
#     宁可池暂时超红线也不删（删了 venv 当场报废）。
# 默认值与 python 侧逐字对齐：单版本 250MB，总池 4GB。
INTERPRETER_SINGLE_VERSION_MB=250
INTERPRETER_TOTAL_GB=4

# ⚠ 关于 3.7：uv 的可下载清单只覆盖 3.8 ~ 3.14，**不含 3.7**（升级 uv 也不
#   解决）。3.7 需部署方离线预填解释器缓存卷，步骤见
#   docs/design/python-task-upload-and-multiversion/OFFLINE-PROVISIONING.md

# ---- 日志 ----
LOG_LEVEL=info
# 日志格式：text（默认）或 json（8-3，结构化工件，便于 ELK/Loki 聚合）
LOG_FORMAT=text

# ---- 磁盘水位红线（P2/L-2，对齐 executor-python）----
# TTL 清扫按 mtime（LOG_RETENTION_DAYS）回收；磁盘在 TTL 窗口内被撑满时补两道防线：
#   * 告警水位（默认 90%）：记 warning，并以减半 TTL 立即再跑一轮紧急清理；
#   * 临界水位（默认 95%）：除紧急清理外，accept 阶段直接拒新任务。
# 取值范围 [1,100]。
DISK_WARN_PERCENT=90
DISK_CRITICAL_PERCENT=95

# ---- 任务资源隔离（4-2/4-3，audit-r4）----
# 任务子进程的常驻内存看门狗（Windows 无 cgroup/ulimit，用轮询采样兜底；
# Linux 有 bwrap 沙箱时还叠加网络/文件系统隔离，见 EXECUTOR_TASK_SANDBOX）。
#
# 单任务内存上限（MB）。>0 时启动内存看门狗，任务进程树 RSS 超限即 kill，
# 失败分因 script_error 且 errorMessage 标注 OOM。0/留空 = 不启用（默认，兼容旧行为）。
TASK_MEMORY_LIMIT_MB=0
# 看门狗采样间隔（毫秒，默认 2000）。越小越灵敏、IO 开销越大。
TASK_MEMORY_WATCHDOG_INTERVAL_MS=2000
# ---- 任务子进程 POSIX 硬资源上限（L-3，对齐 executor-python sandbox.py）----
# node 无 preexec_fn，生产路径把任务命令包一层 `/bin/sh -c 'ulimit …; exec "$0" "$@"'`
# 在 fork 后、exec 前施加；Windows 无 ulimit，跳过并记一行日志（开发机不崩，
# 生产跑在 Linux 容器）。
# 打开文件描述符软/硬上限（ulimit -n，默认 1024，与 python TASK_NOFILE_LIMIT 同值）。
# 0 = 不设。防止 fd 泄漏耗尽执行器 fd。
TASK_NOFILE_LIMIT=1024
# CPU 秒数上限（ulimit -t，RLIMIT_CPU）。0 = 回落为「任务超时 + 60s 宽限」
# （任务超时本身会 kill，这里是防它失效的第二道保险）。
TASK_CPU_LIMIT_SECONDS=0
# 任务子进程隔离模式（Linux only，executor-python sandbox.py 的对等实现）：
#   none          = 不隔离（默认，兼容旧行为；Windows 强制此值）
#   bubblewrap   = 用 bwrap 创建私有 /tmp、/home 与只读系统目录，阻断宿主机
#                  文件系统越权读写（4-3 的文件系统面）。需系统已安装 bwrap，
#                  且任务命令不依赖任务目录之外的宿主路径；容器内 bwrap 需要
#                  容器自身允许 unshare（--privileged 或 seccomp 放行）。
# 注意：网络级隔离（netns/iptables）在 Windows 裸机上不可行，属已知限制，
# 生产建议在容器/网络层叠加 egress 策略（与 python 侧同级别文档化）。
EXECUTOR_TASK_SANDBOX=none

# ---- 拉取模式容量预留（1-3，audit-r4）----
# pull 模式预留槽位被占用但未在期限内 accept 时，视为预留者已崩溃，
# 超时后自动释放（防 Atomics 预留泄漏）。默认 120000ms（2 分钟）。
PULL_STALL_TIMEOUT_MS=120000
