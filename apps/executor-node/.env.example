# ============================================================
# executor-node 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 执行器身份 ----
# 实例名称，注册到 admin-api 时显示
APP_NAME=executor-node-1
# 监听端口
PORT=8002
# 执行器在内部网络的地址（admin-api 回调用）
EXECUTOR_ADDRESS=localhost:8002
# 执行器对外公网地址（留空则使用 EXECUTOR_ADDRESS）
EXECUTOR_ADDRESS_PUBLIC=

# ---- Admin API 连接 ----
ADMIN_API_URL=http://localhost:3105
# 容器内访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_INTERNAL=
# 公网访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_EXTERNAL=
# 多 admin-api 地址，逗号分隔（高可用场景）
ADMIN_API_URLS=

# ---- 鉴权 ----
# 须与 admin-api EXECUTOR_SECRET 一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars
# 兼容旧版字段名（与 EXECUTOR_SECRET 二选一即可）
# EXECUTOR_SHARED_TOKEN=

# ---- 任务执行 ----
# 任务工作目录
WORK_DIR=/tmp/autocodeflow/tasks
# 最大并发任务数
MAX_CONCURRENT_TASKS=10
# 日志保留天数
LOG_RETENTION_DAYS=7

# ---- 私有包仓库 (可选) ----
# 私有 npm registry 地址（留空则使用 npmjs.com）
NPM_REGISTRY_URL=
# 私有 PyPI registry 地址（留空则使用 pypi.org）
PYTHON_REGISTRY_URL=

# ---- 日志 ----
LOG_LEVEL=info
