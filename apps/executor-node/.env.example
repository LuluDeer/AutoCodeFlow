# ============================================================
# executor-node 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 执行器身份 ----
# 实例名称，注册到 admin-api 时显示
APP_NAME=executor-node-1
# 监听端口
PORT=8002
# 执行器在内部网络的地址（admin-api 回调用）
EXECUTOR_ADDRESS=localhost:8002
# 执行器对外公网地址（留空则使用 EXECUTOR_ADDRESS）
EXECUTOR_ADDRESS_PUBLIC=

# ---- Admin API 连接 ----
ADMIN_API_URL=http://localhost:3105
# 容器内访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_INTERNAL=
# 公网访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_EXTERNAL=
# 多 admin-api 地址，逗号分隔（高可用场景）
ADMIN_API_URLS=

# ---- 鉴权 ----
# 须与 admin-api EXECUTOR_SECRET 一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars
# 兼容旧版字段名（与 EXECUTOR_SECRET 二选一即可）
# EXECUTOR_SHARED_TOKEN=

# ---- 任务执行 ----
# 任务工作目录
WORK_DIR=/tmp/autocodeflow/tasks
# 最大并发任务数
MAX_CONCURRENT_TASKS=10
# 日志保留天数
LOG_RETENTION_DAYS=7

# ---- 私有包仓库 (可选) ----
# 私有 npm registry 地址（留空则使用 npmjs.com）
NPM_REGISTRY_URL=
# 私有 PyPI registry 地址（留空则使用 pypi.org）
PYTHON_REGISTRY_URL=

# ---- Python 解释器缓存池与多版本（python_task_multiversion）----
# executor-node 的 python 分支与 executor-python 对等：任务声明 runtimeVersion
# 时按声明版本获取解释器建 venv 运行；不声明版本且无依赖时保持既有行为
# （直接以宿主 python3 运行，逐字节不变）。
#
# uv 可执行文件路径（可选）。留空时按以下顺序自动解析：
#   1) 本变量显式指定；
#   2) PATH 中查找 uv；
#   3) 桌面端（executor-desktop）随包内置的 uv —— Electron 主进程会自动
#      注入 UV_BIN 指向 process.resourcesPath/uv/uv[.exe]，**无需手工配置**；
#   4) 都不可用 → 解释器清单为空；声明版本的任务明确失败
#      （分因 interpreter_unavailable，reason=uv_missing，消息指引安装 uv
#      或使用内置）；未声明版本的任务行为完全不变（向后兼容硬要求）。
UV_BIN=

# 解释器缓存池根目录（可选）。**留空时的默认值与 executor-python 不同**：
# 本执行器取 WORK_DIR 的**兄弟目录** `interpreters`（即 `path.resolve(WORK_DIR,
# '..', 'interpreters')`），而非固定的 /data/interpreters。
# ⚠ 与 executor-python 同约束：必须位于 WORK_DIR 之外，否则会被磁盘 TTL
#   清扫误删（解释器是可复用资产，删了要重新下载，离线环境永久不可恢复）。
#   compose 部署已显式设为 /data/interpreters（与 python 执行器共享同一卷）；
#   裸机/桌面端如需共享同一份解释器层，请把两边的本变量指向同一目录。
UV_PYTHON_INSTALL_DIR=

# 解释器下载镜像（可选，私有化模式 A）。留空 = 走 uv 默认下载源
# （Astral CDN / GitHub Releases，在线主路径）。
# 内网/无外网部署填内网镜像地址。仅 http(s)，且不得含 userinfo/query/fragment。
UV_PYTHON_INSTALL_MIRROR=

# 单次解释器下载的独立超时预算（秒，默认 300，D11），与任务剩余超时取较小者。
# 实测单版本首次下载约 13~17s；弱网现场可下调或上调。
# 取值越界不报错：钳到 [1, 86400]（避免手滑填 0 让每次下载立即超时）。
INTERPRETER_DOWNLOAD_TIMEOUT_SECONDS=300

# 注：缓存池体积红线（INTERPRETER_SINGLE_VERSION_MB / INTERPRETER_TOTAL_GB）
# 与可声明版本区间（PYTHON_RUNTIME_VERSION_MIN/MAX）**仅由 executor-python
# 与 admin-api 读取**，executor-node 当前不实现体积红线与最久未使用回收
# （其 interpreters 模块只提供 discover/ensure/resolve/isOnlineDownloadable/
# invalidateCache，见 CONTRACT.md §3.3）。node 侧如需池容量治理，请在其宿主
# 层做磁盘监控，或在 compose 中用 executor-python 承载多版本任务。
# 不要在此文件填这两个变量——它们不会生效。

# ⚠ 关于 3.7：uv 的可下载清单只覆盖 3.8 ~ 3.14，**不含 3.7**（升级 uv 也不
#   解决）。3.7 需部署方离线预填解释器缓存卷，步骤见
#   docs/design/python-task-upload-and-multiversion/OFFLINE-PROVISIONING.md

# ---- 日志 ----
LOG_LEVEL=info
