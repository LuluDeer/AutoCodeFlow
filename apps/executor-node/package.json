{
  "name": "executor-node",
  "version": "2.0.0",
  "description": "AutoCodeFlow Node.js Executor",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn src/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "^17.4.2",
    "express": "4.22.2",
    "js-yaml": "^4.1.0",
    "winston": "3.19.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.42.0",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/generated/**",
      "!**/*.spec.ts",
      "!**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 62,
        "functions": 80,
        "lines": 80
      }
    },
    "_comment-coverage": "L-3（测试体系审计）：此前 31 spec / ~676 用例无任何覆盖率收集或门控。阈值为 2026-09-18 实测水位地板（stmts 80.26 / branch 65.99 / funcs 82.92 / lines 82.03，留 ~2-4pt 余量），防新增代码完全未测而 CI 仍绿；覆盖率抬升后应同步上调。"
  }
}
