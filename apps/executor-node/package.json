{
  "name": "executor-node",
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "description": "AutoCodeFlow Node.js Executor",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn src/main.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "winston": "3.19.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "argparse": "2.0.1",
    "qs": "^6.16.0",
    "test-exclude": {
      "glob": "^10.5.0",
      "brace-expansion": "^2.1.7"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/generated/**",
      "!**/*.spec.ts",
      "!**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 62,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "_jestCoverageComment": "L-3（测试体系审计）：此前 31 spec / ~676 用例无任何覆盖率收集或门控。阈值为 2026-09-18 实测水位地板（stmts 80.26 / branch 65.99 / funcs 82.92 / lines 82.03，留 ~2-4pt 余量），防新增代码完全未测而 CI 仍绿；覆盖率抬升后应同步上调。"
}
