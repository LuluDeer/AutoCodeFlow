{
  "name": "executor-desktop",
  "version": "1.0.0",
  "author": "kirdeer",
  "description": "AutoCodeFlow Executor Desktop Client",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:executor": "bash scripts/bundle-executor.sh",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:executor && npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:main": "tsc -p tsconfig.selftest.json && node dist-selftest/path-domain.selftest.js && node dist-selftest/token-crypto.selftest.js && node dist-selftest/updater.selftest.js && node dist-selftest/notifier-rules.selftest.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "auto-launch": "5.0.6",
    "electron-log": "5.1.7",
    "electron-store": "8.2.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/auto-launch": "5.0.5",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vercel/ncc": "^0.44.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.4.5",
    "vite": "^8.2.1",
    "vite-plugin-electron": "0.28.7",
    "vite-plugin-electron-renderer": "0.14.5"
  }
}
