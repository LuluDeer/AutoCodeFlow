# ============================================================
# admin-api 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 应用 ----
NODE_ENV=development
PORT=3105
# http 或 https
APP_PROTOCOL=http
# HTTP 请求超时 (毫秒)，SSE/流式端点不受此限制
REQUEST_TIMEOUT_MS=30000
# 对外可达的 API 基地址（APP-002）。POST /applications/upload 用它拼
# {API_BASE_URL}/uploads/packages/{name}_{ts}.zip 存进 applications.packageUrl，
# 由**执行器**下载——必须是执行器能访问到的地址，不是浏览器能访问的地址。
#   执行器与 admin 同机         → http://localhost:3105
#   执行器在局域网/另一台机器   → http://192.168.x.x:3105（不要用 localhost）
#   反代/域名部署               → https://autoflow.example.com
# 未配置时上传接口直接 500（fail-fast，不静默存 localhost 这种不可达 URL）。
API_BASE_URL=http://localhost:3105
# 执行器回连 admin 的对外基址（R-12；install-cmd / executor-package push 用它拼接）。
# 未配置时 GET /executors/install-cmd 返回 503。容器部署通常填内网地址。
ADMIN_API_URL=http://localhost:3105

# ---- 数据库 (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# 生产环境要求 >= 16 字符且不能是常见弱密码
DB_PASSWORD=postgres
DB_DATABASE=autocodeflow
DB_POOL_SIZE=20
# ---- 只读副本 (ARCH-24, 可选，默认关闭) ----
# 读写分离：留空 = 关闭（默认，全部读写走主库）；配置 postgres:// 连接串后，
# SELECT 类读面（列表查询等）经 TypeORM 内建路由走该副本，写面/事务/迁移
# 恒走主库。副本须为主库的流复制/RDS read replica（见 docs/deployment.md
# 「读写分离」段：复制延迟的影响与调度查询的结论）。
# DB_READ_REPLICA_URL=postgres://readonly@localhost:5433/autocodeflow

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT 认证 ----
# 生产环境要求 >= 32 字符，生成示例: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_random_secret_32chars

# ---- CORS ----
# 逗号分隔的允许来源列表（生产环境不能含 localhost）
CORS_ORIGINS=http://localhost:5176,http://localhost:3105
ADMIN_WEB_ORIGIN=http://localhost:5176

# ---- 执行器鉴权 ----
# 所有执行器连接时使用的共享密钥，生产环境要求 >= 16 字符
# 须与各执行器的 EXECUTOR_SECRET 保持一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars

# ---- 执行器最低版本门禁 (EXE-VER-1) ----
EXECUTOR_MIN_VERSION=

# ---- 执行类写面归属口径 (TASK-SCOPE-01) ----
# 控制 POST /tasks/:id/{trigger,pause,resume} 谁能调用。
# 默认 owner（configuration.ts：未设置即收紧）：仅 ADMIN、任务属主、或该项目内
# editor 及以上角色。项目 viewer 始终被拒。
# any：任何已登录用户都可操作任意任务 —— 宽松语义，仅在确需"全员可跑他人
# 任务"时才显式设置。
# 说明：默认收紧是行为变更。仅当你的团队依赖"我能跑同事的任务"时，才取消
# 下行注释显式设为 any。
# TASK_OPERATE_SCOPE=any

# ---- 执行器 pull 派发模式 (ARCH-32) ----
EXECUTOR_PULL_WAIT_MS=25000
EXECUTOR_PULL_TTL_MS=900000
# ARCH-33（ADR-016）：控制面命令队列的载荷过期阈值。默认 30min，**刻意长于**
# 任务载荷（15min）——丢任务的后果是执行行卡住、由既有 stale sweep 收敛；
# 丢控制命令没有任何兜底（部署指令消失后 app_deployments 行会停在 DEPLOYING
# 直到 cron sweep 才判失败，stop/uninstall 这类 best-effort 命令丢了连痕迹都没有）。
EXECUTOR_CMD_TTL_MS=1800000
# F-07：调度候选执行器池上限（selectLeastLoaded / dispatch 的 take 截断）。
# 默认 500；数千台边缘执行器舰队可调大（超上限的执行器永不进候选集）。
EXECUTOR_CANDIDATE_POOL_SIZE=500
# ARCH-35 P1（生产事故 2026-09-23）：部署归属偏好。默认 true——派发时优先选
# 「该应用确实部署在此」的执行器（app_deployments.status='running'），它满了/
# 离线了自动降级回全机队（只改尝试顺序，不剔除候选，故零新增失败面）。
# 置 false = 回到纯负载择优（事故行为：部署在 A，任务可能跑在 B）。
EXECUTOR_PREFER_DEPLOYED=true

# ---- 任务 secrets 落库加密 (SEC-02) ----
# 任务级凭据（tasks.secrets）的 at-rest 加密密钥：32 字节 hex（openssl rand -hex 32）
# 或 base64。留空 = 降级明文存储（启动时 warn 一次，零破坏升级路径）。
# 配置后所有新写入的 secrets 均为 AES-256-GCM `enc:v1:` 信封；轮换 = 换 key 后
# 对任务做一次任意 update（首次 update 自然重加密）。生产环境必须配置。
SEC_SECRETS_KEY=

# ---- 执行器心跳 ----
# 心跳间隔 (毫秒)，默认 30000
EXECUTOR_HEARTBEAT_INTERVAL=30000
# 心跳超时倍数：超过 interval * multiplier 未收到心跳则标记离线
EXECUTOR_HEARTBEAT_TIMEOUT_MULTIPLIER=3

# ---- AI 集成 (可选) ----
# disabled | openai | ollama | qwen
AI_PROVIDER=disabled
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama (本地)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
# Qwen / DashScope（P1：多模态——文本 + 图片 + 视频理解）
# 走 OpenAI 兼容端点；出站走与 openai 相同的 SSRF 守卫 + DNS pin。
# 令牌上限与超时独立配置（openai 分支硬编码 500 令牌，是给失败日志分析的，
# 多模态推理远不够用；视频理解延迟高，超时默认 2 分钟）。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max
QWEN_MAX_TOKENS=4096
QWEN_TIMEOUT_MS=120000

# ---- 中台 Agent（P2/P4，全部可选——不配置即用默认值，存量部署零变化）----
# 预算闸门（代码层强制，见 docs/design/agent-and-deployment/02 §5.3）
AGENT_BUDGET_MAX_STEPS=20
AGENT_BUDGET_MAX_TOKENS=200000
AGENT_BUDGET_WALL_CLOCK_MS=1800000
AGENT_BUDGET_MAX_TOOL_CALLS=50
# 触发器：事件先过聚合窗口（windowMs 内同类事件 ≥ threshold 才起一个 incident
# 会话），定时巡检每小时一次且仅 leader 实例执行
AGENT_TRIGGER_ENABLED=true
AGENT_TRIGGER_CRON_ENABLED=true
AGENT_TRIGGER_WINDOW_MS=300000
AGENT_TRIGGER_THRESHOLD=3
# 会话通知：成功且有结论→INFO / 失败或预算超限→ERROR / 待审批→WARNING；
# 无结论的巡检会话不通知（静默成功）。渠道本身在通知设置页配置。
AGENT_NOTIFY_ENABLED=true
# P6 协作面随 poll 下发的 SOP 策略（设计文档 11 §3.1）。执行器侧 P7 做
# min(本地, 中台) 合并；离线沿用最近一次缓存。
AGENT_SOP_POLICY=standard
AGENT_SOP_POLICY_ALLOWED=minimal,standard
# P6 超时治理（11 §6）：领取超时 / 进度心跳停滞阈值（毫秒）
SOP_ASSIGNMENT_CLAIM_TTL_MS=1800000
SOP_ASSIGNMENT_PROGRESS_TTL_MS=600000
# 澄清复核兜底（11 §6「澄清无人回 → 转人工」）：复核会话超此时长仍未答复 → escalated
SOP_CLARIFICATION_REVIEW_TTL_MS=1800000
# Agent 媒体（截图/录屏）保留天数（P7b 残差补齐；每日 03:15 清理）
AGENT_MEDIA_RETENTION_DAYS=7

# ---- 告警路由 — Alertmanager webhook 入站 (OBS-02, 可选) ----
# POST /api/alerts/webhook 的 HMAC-SHA256 鉴权 secret（签名约定与发版 webhook
# 相同：`sha256=HMAC(secret, "${timestamp}.${rawBody}")`，header
# X-AutoCodeFlow-Timestamp + X-Hub-Signature-256）。留空 = 端点 503 禁用
# （安全缺省，绝不无鉴权接收）。Alertmanager 侧 receiver/route 配置样例见
# docs/observability/README.md 的 OBS-02 段。建议 openssl rand -hex 32。
ALERT_WEBHOOK_SECRET=

# ---- 通知 — 企业微信 (可选) ----
WECOM_WEBHOOK=

# ---- 通知 — 钉钉 (可选) ----
DINGTALK_WEBHOOK=

# ---- 通知 — Slack (可选) ----
SLACK_WEBHOOK=

# ---- 通知 — 飞书自定义机器人 (可选, NF-05) ----
# open.feishu.cn 自定义机器人 webhook 地址；FEISHU_SECRET 为可选加签密钥
# （机器人开启「签名校验」时必须配置，留空 = 不加签模式）
FEISHU_WEBHOOK=
FEISHU_SECRET=

# ---- 通知 — 跨实例共享状态刷新周期 (ARCH-31, 可选) ----
# 渠道配置（PATCH /notification/channels/:key 保存值）与通知静默规则在
# 多实例部署下以 DB 为共享真相，各实例按周期读穿。单实例部署无需调整。
# CHANNEL_CONFIG_REFRESH_MS=15000
# SILENCE_REFRESH_MS=15000

# ---- 通知 — 邮件 (可选) ----
EMAIL_HOST=
EMAIL_PORT=465
# true 表示使用 SSL/TLS，false 表示 STARTTLS
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=autocodeflow@noreply.com
# 默认收件人，逗号分隔
EMAIL_TO=

# ---- 日志 ----
LOG_LEVEL=info

# ---- 执行日志存储 (可选，优化笔记 2.6) ----
# db = 日志行写入 PostgreSQL execution_log_lines（默认）
# s3 = 每次执行一个 gzip 对象写入 MinIO/S3，主库只存对象引用
# 使用 s3 时需提供 MinIO 端点与密钥；上传失败会自动回退 db 行存储
LOG_STORAGE_DRIVER=db
LOG_STORAGE_ENDPOINT=
LOG_STORAGE_BUCKET=autoflow-logs
LOG_STORAGE_ACCESS_KEY=
LOG_STORAGE_SECRET_KEY=
LOG_STORAGE_USE_SSL=false
LOG_STORAGE_REGION=

# ---- 执行日志分区清理 (ARCH-22) ----
# execution_log_lines 已按日 RANGE 分区（迁移 1789900000002）。
# true（默认）= 清理走 DETACH PARTITION + 每日自动预建未来 7 天分区；
# false = 清理回退为分批 DELETE（schema 不回滚，重新开启无需再跑迁移）。
# 保留天数仍由 LOG_RETENTION_DAYS 控制。运维细节见 docs/operations.md。
LOG_PARTITION_ENABLED=true

# ---- 限流分域 (SEC-09) ----
# THROTTLE_ENABLED=false 时全局旁路所有限流（灰度/排障逃生门，默认 true 生效）
THROTTLE_ENABLED=true
# 严格档：auth 敏写面（POST /auth/refresh、/auth/totp/*），默认 10 次/60s/IP
# （防爆破，与 account lockout 互补；login 保留 LOGIN_THROTTLE_LIMIT 契约）
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60000
# 中档：触发/执行干预写面（trigger/kill/rollback/pause/resume/deploy/审批等），
# 默认 30 次/60s/IP
THROTTLE_OPS_LIMIT=30
THROTTLE_OPS_TTL=60000
# 机器回调面（executor → admin-api）：执行结果上报/心跳。**按 IP 计**——多个
# 执行器位于同一出口 IP（NAT/容器同宿主）时速率叠加，容易触顶（executor 侧有
# 文件级重试，不丢结果但上报被推迟，可能与 stale sweep 的失败判定赛跑）。
# 单请求最多 100 条结果，故单 IP 条目上限 = limit × 100 / 分钟。
# 调参建议：执行器数 × 各自批次数/分钟 × 安全系数（默认 60 足够 ~30 台低频执行器）。
THROTTLE_CALLBACK_LIMIT=60
THROTTLE_CALLBACK_TTL=60000
# 实时日志流面（executor → admin-api 的 POST /executions/:id/logs）。与回调同属
# 机器面（速率由任务输出节奏决定），但**节奏快得多**：执行器按行缓冲，最多每
# 秒推一片、单片最多 2000 行，故默认 120/min 高于全局默认档 60（否则话痨任务的
# 日志会在执行中途被限流截断，恰是本端点要修的问题）。同样**按 IP 计**——多执行
# 器同出口时速率叠加，调参建议：执行器数 × 分片/分钟 × 安全系数。
THROTTLE_LOG_STREAM_LIMIT=120
THROTTLE_LOG_STREAM_TTL=60000

# ---- 初始管理员账号 (首次部署) ----
# 部署后请立即通过控制台修改密码
INITIAL_ADMIN_PASSWORD=change_me_immediately

# ---- 上传面 zip bomb 防护 (SEC-05) ----
# application / executor-package 上传口的 zip 结构守卫阈值（缺省即安全值）。
# ZIP_MAX_RATIO       解压比上限（CD 声明 uncompressed 总量 / compressed 总量）
# ZIP_MAX_ENTRIES     条目数上限
# ZIP_MAX_FILE_BYTES  单文件解压后上限（字节）
# ZIP_MAX_TOTAL_BYTES 全包声明解压总量上限（字节）
# ZIP_MAX_NESTED_INFLATE_BYTES 单个嵌套 zip 成员解压进堆的上限（字节）
# ZIP_MAX_NESTING_DEPTH 嵌套 zip 积极探测层数（更深层按声明大小计入比率）
ZIP_MAX_RATIO=100
ZIP_MAX_ENTRIES=10000
ZIP_MAX_FILE_BYTES=536870912
ZIP_MAX_TOTAL_BYTES=1073741824
ZIP_MAX_NESTING_DEPTH=1
ZIP_MAX_NESTED_INFLATE_BYTES=67108864

# ---- 可选 clamd 病毒扫描钩子 (SEC-05) ----
# true 时上传包流式 INSTREAM 送 ClamAV 守护进程扫描。
# 失败策略=fail-closed：扫描不可达/超时/异常一律拒绝上传（安全缺省）。
# 默认 false——零影响；开启前先部署 clamd（docker: clamav/clamd）。
CLAMD_ENABLED=false
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=10000

# ---- OpenTelemetry 分布式追踪 (OBS-01) ----
# 默认 false——零开销零行为变化（span 生成短路）。true 时：
#   * admin-api 进程内 span 树（结构化日志 [trace] 行）+ traceId 贯穿落库
#   * dispatch 指令携带 W3C traceparent 头透传执行器，回调回传关联
#   * task_executions.traceId 落库，执行详情页展示/复制
# 仅用 @opentelemetry/api（不引 sdk-*/exporter）；Jaeger/Tempo 接入路径
# 见 docs/deployment.md「OTEL / Jaeger」段（compose --profile jaeger）。
OTEL_ENABLED=false

# ---- 出站 webhook 跨进程 outbox (FEAT-19) ----
# true（默认）= 出站事件派发入口同步落 event_outbox 表，OutboxDispatcher
# 启动 + 每 5s 扫描未派发行补投（跨进程重启不丢待投事件，at-least-once，
# 订阅方须幂等）；false = 回退纯进程内派发（FEAT-07 原行为，重启丢在途）。
EVENT_OUTBOX_ENABLED=true
