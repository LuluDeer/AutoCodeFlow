# ============================================================
# admin-api 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 应用 ----
NODE_ENV=development
PORT=3105
# http 或 https
APP_PROTOCOL=http
# HTTP 请求超时 (毫秒)，SSE/流式端点不受此限制
REQUEST_TIMEOUT_MS=30000

# ---- 数据库 (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# 生产环境要求 >= 16 字符且不能是常见弱密码
DB_PASSWORD=postgres
DB_DATABASE=autocodeflow
DB_POOL_SIZE=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT 认证 ----
# 生产环境要求 >= 32 字符，生成示例: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_random_secret_32chars

# ---- CORS ----
# 逗号分隔的允许来源列表（生产环境不能含 localhost）
CORS_ORIGINS=http://localhost:5176,http://localhost:3105
ADMIN_WEB_ORIGIN=http://localhost:5176

# ---- 执行器鉴权 ----
# 所有执行器连接时使用的共享密钥，生产环境要求 >= 16 字符
# 须与各执行器的 EXECUTOR_SECRET 保持一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars

# ---- 执行器心跳 ----
# 心跳间隔 (毫秒)，默认 30000
EXECUTOR_HEARTBEAT_INTERVAL=30000
# 心跳超时倍数：超过 interval * multiplier 未收到心跳则标记离线
EXECUTOR_HEARTBEAT_TIMEOUT_MULTIPLIER=3

# ---- AI 集成 (可选) ----
# disabled | openai | ollama
AI_PROVIDER=disabled
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama (本地)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- 通知 — 企业微信 (可选) ----
WECOM_WEBHOOK=

# ---- 通知 — 钉钉 (可选) ----
DINGTALK_WEBHOOK=

# ---- 通知 — Slack (可选) ----
SLACK_WEBHOOK=

# ---- 通知 — 邮件 (可选) ----
EMAIL_HOST=
EMAIL_PORT=465
# true 表示使用 SSL/TLS，false 表示 STARTTLS
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=autocodeflow@noreply.com
# 默认收件人，逗号分隔
EMAIL_TO=

# ---- 日志 ----
LOG_LEVEL=info

# ---- 初始管理员账号 (首次部署) ----
# 部署后请立即通过控制台修改密码
INITIAL_ADMIN_PASSWORD=change_me_immediately
