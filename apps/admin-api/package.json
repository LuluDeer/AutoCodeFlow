{
  "name": "admin-api",
  "version": "0.0.1",
  "description": "AutoCodeFlow Admin API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node scripts/prebuild-install-script.mjs",
    "build": "nest build -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "swagger:export": "jest --config ./test/jest-e2e.json -t \"OpenAPI export\"",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@types/multer": "^2.1.0",
    "@types/redis": "^4.0.10",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "ioredis": "^5.3.2",
    "joi": "^18.2.1",
    "minio": "^8.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!app.module.ts",
      "!data-source.ts",
      "!config/configuration.ts",
      "!common/filters/http-exception.filter.ts",
      "!common/utils/shutdown-guard.util.ts",
      "!migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 69,
        "lines": 84,
        "statements": 84
      }
    }
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "multer": "2.3.0"
  },
  "_comment-deps": "F-15（本轮审计）: class-validator ^0.14.4 = npm 当前 0.14.x 最新（0.14.1+ 的既定安全修复线；升级前实测 node_modules 已解析到 0.14.4，manifest 与解析结果对齐）。class-transformer 保持 ^0.5.1：0.5.1 即 npm 最新版（不存在 0.5.2）。0.15.x 属 0.x 语义内的大步进（潜在 breaking），未纳入本轮，待全量回归后另行评估。",
  "_comment-overrides": "F-16（本轮审计）: overrides.multer=2.3.0 为统一规避 multer <2.x 的安全公告（busboy 解析 DoS 等）；npm 不支持 JSON 注释，故以 _comment 键登记锁定原因。升级 @nestjs/platform-express 自带 multer 前，任何改动须先核对 CVE 状态。package.json 顶层 _ 前缀键仅供本地记录，不影响 npm install 解析。"
}
