{
  "name": "admin-api",
  "version": "0.0.1",
  "description": "AutoCodeFlow Admin API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node scripts/prebuild-install-script.mjs",
    "build": "nest build -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx --node-options=--experimental-vm-modules jest",
    "test:watch": "npx --node-options=--experimental-vm-modules jest --watch",
    "test:cov": "npx --node-options=--experimental-vm-modules jest --coverage",
    "test:e2e": "npx --node-options=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "swagger:export": "npx --node-options=--experimental-vm-modules jest --config ./test/jest-e2e.json -t \"OpenAPI export\"",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@types/multer": "^2.2.0",
    "@types/redis": "^4.0.11",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "js-yaml": "5.2.3",
    "minio": "^8.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!app.module.ts",
      "!data-source.ts",
      "!config/configuration.ts",
      "!common/filters/http-exception.filter.ts",
      "!common/utils/shutdown-guard.util.ts",
      "!migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 78,
        "lines": 85,
        "statements": 84
      }
    }
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "multer": "2.4.0",
    "typeorm": {
      "ioredis": "$ioredis"
    }
  },
  "_comment-deps": "F-15（本轮审计）: class-validator ^0.14.4 = npm 当前 0.14.x 最新（0.14.1+ 的既定安全修复线；升级前实测 node_modules 已解析到 0.14.4，manifest 与解析结果对齐）。class-transformer 保持 ^0.5.1：0.5.1 即 npm 最新版（不存在 0.5.2）。0.15.x 属 0.x 语义内的大步进（潜在 breaking），未纳入本轮，待全量回归后另行评估。",
  "_comment-overrides": "F-16（本轮审计）: overrides.multer=2.3.0 为统一规避 multer <2.x 的安全公告（busboy 解析 DoS 等）；npm 不支持 JSON 注释，故以 _comment 键登记锁定原因。升级 @nestjs/platform-express 自带 multer 前，任何改动须先核对 CVE 状态。package.json 顶层 _ 前缀键仅供本地记录，不影响 npm install 解析。",
  "_comment_overrides": "overrides.multer=2.4.0 为统一规避 multer <2.x 的安全公告；overrides.typeorm.ioredis=$ioredis 用于让 typeorm@1.1.1 的 peerOptional ioredis@^5.0.4 放行到根依赖的 ioredis@6（typeorm 仅在配置 Redis 缓存/订阅时才触碰 ioredis，本服务未使用，peer 范围未跟上 ioredis 6 属上游滞后），待 typeorm 放宽 peer 后可移除。"
}
