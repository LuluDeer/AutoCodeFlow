APP_NAME=executor-python-1
PORT=8001
EXECUTOR_ADDRESS=executor-python:8001
# EXECUTOR_ADDRESS_PUBLIC=  # Public address for external access
ADMIN_API_URL=http://admin-api:3001
# ADMIN_API_URL_INTERNAL=  # Internal admin API URL (default: same as ADMIN_API_URL)
# ADMIN_API_URL_EXTERNAL=  # External admin API URL for callback
WORK_DIR=/tmp/autocodeflow/tasks
MAX_CONCURRENT_TASKS=10
# TASK_TIMEOUT_SECONDS=300  # Default task timeout (5 minutes)
# HEARTBEAT_INTERVAL_SECONDS=30  # Heartbeat interval
# PYPI_REGISTRY_URL=  # Private PyPI registry URL for task dependencies