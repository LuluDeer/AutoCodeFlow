# ============================================================
# executor-python 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 执行器身份 ----
# 实例名称，注册到 admin-api 时显示
APP_NAME=executor-python-1
# 监听端口
PORT=8001
# 执行器在内部网络的地址（admin-api 回调用）
EXECUTOR_ADDRESS=localhost:8001
# 执行器对外公网地址（留空则使用 EXECUTOR_ADDRESS）
EXECUTOR_ADDRESS_PUBLIC=

# ---- 派发模式（ARCH-32 / ADR-015 + ARCH-33 / ADR-016）----
# true = pull 模式：执行器主动长轮询 admin-api 领取任务与**控制面命令**
#   （部署/停止/卸载/配置热更新/终止执行/包更新），admin 无需反向连入。
#   公网中台 + 内网执行器（NAT）拓扑必须开启——push 模式下 admin 拨入内网
#   地址必然超时。
# false（默认）= push 模式：admin 反向 POST 到本执行器。
# 注意：控制面命令通道要求协议 v2（本版本已上报 PROTOCOL_VERSION=2）；
# 中台按 protocolVersion 决定是否下发 commands，旧中台/旧执行器行为不变。
EXECUTOR_PULL_MODE=false

# ---- Admin API 连接 ----
ADMIN_API_URL=http://localhost:3105
# 容器内访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_INTERNAL=
# 公网访问地址（留空则使用 ADMIN_API_URL）
ADMIN_API_URL_EXTERNAL=

# ---- 鉴权 ----
# 须与 admin-api EXECUTOR_SECRET 一致
EXECUTOR_SECRET=change_me_to_a_random_token_16chars
# 兼容旧版字段名（与 EXECUTOR_SECRET 二选一即可）
# EXECUTOR_SHARED_TOKEN=

# ---- 任务执行 ----
# 任务工作目录
WORK_DIR=/tmp/autocodeflow/tasks
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5176
# SEC-NEW-2：S7 gitRepo SSRF 守卫私网放行开关（与 admin-api 同名变量语义对齐）
# 默认 false = 私网/loopback gitRepo 一律拒绝；true 时放行 RFC1918 内网
# GitLab/Gitea（10/8、172.16/12、192.168/16），loopback（localhost/127.x）仍拒绝
EXECUTOR_ALLOW_PRIVATE_NETWORK=false

# ---- 私有包仓库 (可选) ----
# 私有 PyPI registry 地址（留空则使用 pypi.org）
PYPI_REGISTRY_URL=

# ---- Python 解释器缓存池与多版本（python_task_multiversion）----
# 任务可按 runtimeVersion 声明 Python 主.次版本（如 3.7 / 3.12 / 3.13），
# 执行器按需获取对应解释器建 venv 运行；不声明则沿用宿主解释器（存量语义）。
#
# 解释器缓存池根目录（多个任务 venv 复用同一解释器层，避免重复下载）。
# ⚠ 必须位于 WORK_DIR 之外：WORK_DIR 受磁盘 TTL 清扫（DISK_CLEANUP_TTL_DAYS，
#   默认 7 天）管理，解释器是可复用资产，一旦被 TTL 误删就要重新下载（离线
#   环境下则永久不可恢复）。默认 /data/interpreters 与 /data/tasks 物理隔离，
#   且 maintenance 显式豁免该目录。不要设成 $WORK_DIR/interpreters 之类子目录。
UV_PYTHON_INSTALL_DIR=/data/interpreters

# 解释器下载镜像（可选，私有化模式 A）。留空 = 走 uv 默认下载源
# （Astral CDN / GitHub Releases，在线主路径，所有部署必有）。
# 内网部署且无外网时填内网镜像地址。格式约束同 PYPI_REGISTRY_URL：
# 仅 http(s)，且不得含 userinfo（凭据）/ query / fragment。
UV_PYTHON_INSTALL_MIRROR=

# 单次解释器下载的独立超时预算（秒，默认 300，D11）。与任务剩余超时取较小者
# 生效。实测单版本首次下载约 13~17s（约 20~30MiB），300s 余量充裕；
# 弱网/跨境现场可下调（如 120）或上调，按部署网络情况配置。
INTERPRETER_DOWNLOAD_TIMEOUT_SECONDS=300

# 缓存池体积红线（D12）。解释器层豁免常规 TTL 清扫，改由体积红线治理：
# 超限触发告警并回收最久未使用版本（按目录 mtime）。
# 单版本上限（MB）：实测单版本解压后约 57MB（3.7.9 Windows 产物含 .pdb 时
#   约 122MB），250MB 红线充裕。
INTERPRETER_SINGLE_VERSION_MB=250
# 缓存池总容量上限（GB）：4GB 约可容纳 10+ 个版本。
# 容量公式：版本数 × 单版本体积(≤250MB) ≤ INTERPRETER_TOTAL_GB
INTERPRETER_TOTAL_GB=4

# 任务可声明的 Python 版本区间（主.次，格式 ^\d+\.\d+$）。
# 默认 3.7 ~ 3.14，与 admin-api 侧同名变量（PYTHON_RUNTIME_VERSION_MIN/MAX）
# 必须保持一致——两侧不一致会导致"能保存但跑不了"或"能跑但存不了"。
# 区间外版本声明一律拒绝。
PYTHON_RUNTIME_VERSION_MIN=3.7
PYTHON_RUNTIME_VERSION_MAX=3.14

# ⚠ 关于 3.7（离线预填扩展，重要）：
#   uv（含仓库锁定的 0.8.17 与更高版本）的可下载清单只覆盖 3.8 ~ 3.14，
#   **不含 3.7**——`uv python install 3.7` 必然失败（No download found），
#   升级 uv 也无法解决。3.7 只能由部署方**离线预填**解释器缓存卷：
#   把 python-build-standalone tag 20200822 的 3.7.9 产物按 uv 目录布局
#   放进 $UV_PYTHON_INSTALL_DIR/cpython-3.7.9-<uv平台三元组>-none/。
#
#   ⚠⚠ 三元组必须用 **uv 自己的词汇**（<os>-<arch>-<libc>），不能用
#   python-build-standalone 的发布三元组。uv 对不匹配的目录名**静默忽略**
#   ——不报错，只是该版本永远不出现在 `uv python list --only-installed` 里，
#   症状是"文件都放对了但执行器始终探测不到"。实测（uv 0.8.17/0.11.14 一致）：
#       Linux x86_64 glibc : linux-x86_64-gnu     ← 非 x86_64-unknown-linux-gnu
#       Linux x86_64 musl  : linux-x86_64-musl    ← 非 x86_64-unknown-linux-musl
#       Linux arm64 glibc  : linux-aarch64-gnu
#       Windows x86_64     : windows-x86_64-none  ← 非 x86_64-pc-windows-msvc
#       macOS x86_64       : macos-x86_64-none    ← 非 x86_64-apple-darwin
#       macOS arm64        : macos-aarch64-none   ← 非 aarch64-apple-darwin
#   自查：`uv python list --all-versions --all-platforms` 查看实际词汇；
#   放好后 `uv python list --only-installed` 必须能列出该版本，否则三元组写错了。
#
#   操作步骤见 docs/design/python-task-upload-and-multiversion/OFFLINE-PROVISIONING.md
#   支持矩阵（含 3.7 仅 x86_64 可用等限制）见同目录 SUPPORT-MATRIX.md。
#   未预填时声明 3.7 的任务会明确失败，分因 interpreter_unavailable。

# ---- 日志 ----
LOG_LEVEL=info

# ---- 磁盘水位红线（P2/L-2，对齐 executor-node）----
# TTL 清扫按 mtime（DISK_CLEANUP_TTL_DAYS，默认 7 天）回收；磁盘在 TTL 窗口内
# 被撑满时没有主动应对，这里补两道防线：
#   * 告警水位（默认 90%）：记 warning，并以减半 TTL 立即再跑一轮紧急清理；
#   * 临界水位（默认 95%）：除紧急清理外，accept 阶段直接拒新任务（磁盘满时
#     任何任务都会在写 workdir/log 阶段失败，提前拒绝比准备阶段失败更诚实）。
# 取值范围 [1,100]，且必须 DISK_WARN_PERCENT < DISK_CRITICAL_PERCENT。计量失败
# 按"无压力"处理，不误拒任务。
DISK_WARN_PERCENT=90
DISK_CRITICAL_PERCENT=95
