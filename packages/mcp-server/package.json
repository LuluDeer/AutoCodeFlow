{
  "name": "autocodeflow-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for AutoCodeFlow — lets AI agents (Claude, Cursor, etc.) manage tasks and executions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "autocodeflow-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
