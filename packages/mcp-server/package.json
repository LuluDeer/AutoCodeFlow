{
  "name": "autocodeflow-mcp-server",
  "version": "1.5.2",
  "description": "MCP server for AutoCodeFlow — lets AI agents (Claude, Cursor, etc.) manage tasks and executions",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf dist"
  },
  "bin": {
    "autocodeflow-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "node-fetch": "3.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuluDeer/AutoCodeFlow.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=20.19"
  }
}
