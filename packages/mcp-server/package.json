{
  "name": "autocodeflow-mcp-server",
  "version": "1.1.1",
  "description": "MCP server for AutoCodeFlow — lets AI agents (Claude, Cursor, etc.) manage tasks and executions",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "autocodeflow-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuluDeer/AutoCodeFlow.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "hono": "^4.13.5"
  }
}
