{
  "name": "@autocodeflow/cli",
  "version": "1.5.2",
  "description": "AutoCodeFlow CLI — manage tasks, executions and applications from the terminal",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "acf": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuluDeer/AutoCodeFlow.git",
    "directory": "packages/acf-cli"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "1.20.0",
    "chalk": "4.1.2",
    "cli-table3": "0.6.5",
    "commander": "12.0.0",
    "conf": "10.2.0",
    "ora": "5.4.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
