# ============================================================
# AutoCodeFlow — 根目录环境变量
# 供 Docker Compose 完整部署使用
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=autoflow
# 生产环境要求 >= 16 字符
POSTGRES_PASSWORD=change_me_strong_password
DB_DATABASE=autoflow

# ---- admin-api 数据库连接 ----
# 容器内默认连接 postgres 服务，通常不需修改
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=autoflow
DB_PASSWORD=change_me_strong_password
DB_POOL_SIZE=20

# ---- JWT 认证 ----
# 生成示例: openssl rand -hex 32（生产要求 >= 32 字符）
JWT_SECRET=change_me_to_a_random_secret_32chars
JWT_REFRESH_SECRET=change_me_to_another_random_secret_32chars

# ---- CORS ----
# 生产环境替换为实际域名，不能含 localhost
CORS_ORIGINS=http://localhost,http://localhost:5176
ADMIN_WEB_ORIGIN=http://localhost

# ---- 执行器鉴权 ----
# 所有执行器共享此密钥（生产要求 >= 16 字符）
EXECUTOR_SECRET=change_me_to_a_random_token_16chars

# ---- 限流 (admin-api) ----
# 全局 API 限流（默认 60 次/分钟）；压测时建议调高（如 600）后重启 admin-api，
# 见 scripts/load-test.README.md
THROTTLE_LIMIT=60
THROTTLE_TTL=60000
# 登录接口限流（默认 20/分钟，生产建议 5）
LOGIN_THROTTLE_LIMIT=20

# ---- 调度 / 恢复 (admin-api) ----
# P2: stale sweep 兑现重试预算开关；false = 恢复旧行为（只置 FAILED 不重试）
STALE_RECOVERY_RETRY_ENABLED=true
# SSRF 防护（F-3）：默认拦截回环/私网出站；admin-api 与执行器同机部署时必须设 true
# （compose 默认未注入该变量，需在 compose 的 admin-api environment 或独立部署时传入）
EXECUTOR_ALLOW_PRIVATE_NETWORK=false

# ---- 执行器回调签名 (admin-api + 两侧执行器) ----
# N23: per-execution 回调 token 的 HMAC 密钥（>=16 字符）；可选，缺省回落
# EXECUTOR_SECRET（两侧必须同源）。compose 默认未注入 → 自动回落共享 token
EXECUTION_CALLBACK_SECRET=

# ---- admin-web ----
# Nginx 反向代理中注入给前端的 API 地址
VITE_API_URL_INTERNAL=http://admin-api:3105
VITE_API_URL_EXTERNAL=
# 兼容旧变量名（compose 注入 admin-web 容器）
REACT_APP_API_URL=http://localhost:3105

# ---- 执行器公网地址 (可选，多机部署时填写) ----
EXECUTOR_PYTHON_PUBLIC_ADDRESS=
EXECUTOR_NODE_PUBLIC_ADDRESS=

# ---- Admin API 访问地址 (可选) ----
ADMIN_API_URL_INTERNAL=http://admin-api:3105
ADMIN_API_URL_EXTERNAL=

# ---- 私有包仓库 (可选) ----
# 私有 npm registry（留空使用 npmjs.com）
NPM_REGISTRY_URL=
# 私有 PyPI registry（留空使用 pypi.org）
PYPI_REGISTRY_URL=
# S5: npm registry 服务账号 / 预签发 token（registry-npm 对所有包要求认证，
# 不配置时 admin 的 npm 包列表为空）。token 优先于 user/pass。
# compose 默认未注入，需在 compose environment 或独立部署时传入
NPM_REGISTRY_TOKEN=
NPM_REGISTRY_USER=
NPM_REGISTRY_PASS=
# S4/S5: registry 上传代理超时（毫秒，默认 60000，慢链路可调大）
REGISTRY_UPLOAD_TIMEOUT_MS=60000

# ---- PyPI registry 服务账号 (registry-pypi 服务用) ----
REGISTRY_USER=admin
REGISTRY_PASS=change_me
PYPI_API_KEY=

# ---- AI 集成 (可选) ----
# disabled | openai | ollama
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- 通知 — 企业微信 (可选) ----
WECOM_WEBHOOK=

# ---- 通知 — 钉钉 (可选) ----
DINGTALK_WEBHOOK=

# ---- 通知 — Slack (可选) ----
SLACK_WEBHOOK=

# ---- 通知 — 邮件 (可选) ----
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=autocodeflow@noreply.com
EMAIL_TO=

# ---- 日志 ----
LOG_LEVEL=info
# 执行器工作目录 TTL 清理（executor-node 与 executor-python 两侧）
# 天数；node 侧 TTL 取 max(1, LOG_RETENTION_DAYS || 7)
LOG_RETENTION_DAYS=7

# ---- 执行器安全/行为 (两侧执行器) ----
# S9: 执行器无 token 时拒绝 /api/* 请求（503，fail-closed）；compose 内已设 true
REQUIRE_TOKEN=true

# ---- executor-python 磁盘清理 ----
# E8: 工作目录 TTL 回收（与 node 侧 file-logger 对齐；首次扫描延迟 10 分钟）
DISK_CLEANUP_TTL_DAYS=7
DISK_CLEANUP_INTERVAL_SECONDS=21600
DISK_CLEANUP_INITIAL_DELAY_SECONDS=600

# ---- 执行日志存储 (LOG-02, compose 已接线) ----
# driver=db 时日志行存 execution_log_lines；driver=s3 时每条执行一个 gzip
# 对象存 MinIO/S3（需先启动 minio profile），详见 docs/operations.md
LOG_STORAGE_DRIVER=db
LOG_STORAGE_BUCKET=autoflow-logs
LOG_STORAGE_ENDPOINT=minio:9000
LOG_STORAGE_ACCESS_KEY=autoflow
LOG_STORAGE_SECRET_KEY=
LOG_STORAGE_USE_SSL=false

# ---- MinIO (profile: minio，compose 已接线) ----
# 启用 s3 日志存储时必须设置（MINIO_ROOT_PASSWORD 无默认值，缺失则容器启动失败）
MINIO_ROOT_USER=autoflow
MINIO_ROOT_PASSWORD=

# ---- 初始管理员账号 (首次部署) ----
INITIAL_ADMIN_PASSWORD=change_me_immediately
