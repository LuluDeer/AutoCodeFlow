# AutoFlow 环境变量配置模板
# 复制此文件为 .env 并填入实际值（.env 不提交版本库）

# === 基础配置 ===
APP_NAME=autoflow
NODE_ENV=development
LOG_LEVEL=info

# === 数据库 ===
POSTGRES_USER=autoflow
# ⚠️ 生产环境必须设置强密码（至少16位，包含大小写字母、数字、特殊字符）
POSTGRES_PASSWORD=change-me-in-production
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=autoflow
# ⚠️ 生产环境必须设置强密码（至少16位，包含大小写字母、数字、特殊字符）
DB_PASSWORD=change-me-in-production
DB_DATABASE=autoflow

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === JWT（⚠️ 生产环境必须设置为强随机值）===
# 至少 32 位随机字符串，建议使用: openssl rand -base64 32
JWT_SECRET=change-me-at-least-32-chars-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# === Executor 共享 Token（⚠️ 生产环境必须设置强密钥）===
# 至少 16 位随机字符串，建议使用: openssl rand -base64 16
EXECUTOR_SECRET=change-me-executor-shared-secret
EXECUTOR_SHARED_TOKEN=change-me-executor-shared-secret

# === 服务器端口 ===
PORT=3001

# === 前端配置 ===
ADMIN_WEB_ORIGIN=http://localhost
REACT_APP_API_URL=http://localhost:3001
# ⚠️ 生产环境必须设置，逗号分隔的允许来源（例如: https://admin.example.com,https://app.example.com）
CORS_ORIGINS=http://localhost,http://localhost:5173

# === PyPI 私有仓库 ===
REGISTRY_USER=admin
# ⚠️ 生产环境必须设置强密码
REGISTRY_PASS=change-me-pypi-password
# ⚠️ 生产环境必须设置强密钥
PYPI_API_KEY=change-me-pypi-api-key

# === AI 集成（可选）===
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# === 邮件通知（可选）===
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@example.com
EMAIL_PASS=smtp-password
EMAIL_FROM=AutoFlow <noreply@example.com>
EMAIL_TO=admin@example.com

# === 企业微信通知（可选）===
WECOM_WEBHOOK=

# === 钉钉通知（可选）===
DINGTALK_WEBHOOK=

# === Slack 通知（可选）===
SLACK_WEBHOOK=

# === 初始管理员密码（⚠️ 首次部署时使用，部署后应立即修改）===
INITIAL_ADMIN_PASSWORD=admin123

# === 执行器配置 ===
EXECUTOR_MAX_CONCURRENT_TASKS=10
EXECUTOR_TASK_TIMEOUT_SECONDS=300
EXECUTOR_HEARTBEAT_INTERVAL_SECONDS=30

# === 私有仓库配置（任务依赖安装时使用）===
# 私有 PyPI 仓库地址（用于 executor-python 安装内部包）
PYPI_REGISTRY_URL=http://registry-pypi:8003/simple/
# 私有 npm 仓库地址（用于 executor-node 安装 @autocodeflow/* 包）
NPM_REGISTRY_URL=http://registry-npm:4873
# executor-node 安装 Python 任务依赖时使用的 PyPI 仓库
PYTHON_REGISTRY_URL=http://registry-pypi:8003/simple/
