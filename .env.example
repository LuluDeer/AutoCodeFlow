# ============================================================
# AutoCodeFlow — 根目录环境变量
# 供 Docker Compose 完整部署使用
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=autoflow
# 生产环境要求 >= 16 字符
POSTGRES_PASSWORD=change_me_strong_password
DB_DATABASE=autoflow

# ---- admin-api 数据库连接 ----
# 容器内默认连接 postgres 服务，通常不需修改
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=autoflow
DB_PASSWORD=change_me_strong_password
DB_POOL_SIZE=20
# ---- 只读副本 (ARCH-24, 可选，默认关闭) ----
# 读写分离：留空 = 关闭（默认）；配置 postgres:// 连接串后 SELECT 读面走副本，
# 写面/事务/迁移恒走主库。真实部署建议用云 RDS read replica 或 PG 流复制，
# compose 的 postgres-replica（--profile replica）仅本地联调演示。
# 注意复制延迟对「创建后立即列表可见」的影响，详见 docs/deployment.md。
# DB_READ_REPLICA_URL=postgres://autoflow@postgres-replica:5432/autoflow

# ---- JWT 认证 ----
# 生成示例: openssl rand -hex 32（生产要求 >= 32 字符）
JWT_SECRET=change_me_to_a_random_secret_32chars
JWT_REFRESH_SECRET=change_me_to_another_random_secret_32chars
# 访问令牌有效期（默认 15m）
# JWT_EXPIRES_IN=15m

# ---- Redis（M-2：compose 已强制 requirepass）----
# 生产环境要求 >= 16 字符；未设置时 compose 解析即报错（fail-fast）
REDIS_PASSWORD=change_me_redis_password_16chars
# 连接目标（compose 拓扑键：容器内固定 redis 服务，通常不需修改；
# 独立部署/admin-api 脱离 compose 时才需要——代码默认 localhost:6379）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Redis TLS（ARCH-005，可选）：true 时 ioredis/BullMQ 走 TLS 传输加密；
# 自签证书调试可设 REDIS_TLS_REJECT_UNAUTHORIZED=false（默认校验证书）
# REDIS_TLS=false
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# ---- Alertmanager 告警 webhook 入站 HMAC secret（OBS-02，可选）----
# 未配置时 POST /api/alerts/webhook 返回 503（安全缺省拒绝，防告警伪造）
# monitoring profile 下必须与加签侧车 alertmanager-hmac-proxy 同源（同一个 secret
# 既签又验）；侧车未拿到本值时**拒绝启动**（fail-closed，不做无鉴权转发）。
# 时序提示：签名头带本机时间戳、接收侧只接受 ±5 分钟窗口——侧车与 admin-api
# 跨机部署时须保证 NTP 漂移 < 5 分钟（同宿主 containers 天然一致）。
ALERT_WEBHOOK_SECRET=

# ---- OBS-02 加签侧车（monitoring profile，可选调优）----
# 侧车 scripts/alertmanager-hmac-proxy.mjs 把 Alertmanager 的 webhook 请求加签
# 后转发到 admin-api。以下 4 键在 compose 内已有安全缺省，通常无需设置；
# 仅在非 compose 部署（裸跑侧车 / 自建拓扑）时需要显式指定。
# 裸跑时 bind 默认 127.0.0.1（仅回环）；容器内由 compose 设为 0.0.0.0。
# ALERT_PROXY_TARGET=http://admin-api:3105/api/alerts/webhook
# ALERT_PROXY_BIND=127.0.0.1
# ALERT_PROXY_PORT=9099
# ALERT_PROXY_TIMEOUT_MS=10000

# ---- CORS ----
# 生产环境替换为实际域名，不能含 localhost
# ARCH-001：admin-api 优先读 CORS_ALLOWED_ORIGINS，兼容旧名 CORS_ORIGINS
# CORS_ALLOWED_ORIGINS=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:5176
ADMIN_WEB_ORIGIN=http://localhost
# 本地 demo / 纯 loopback 部署：生产 CORS 校验默认拒绝 localhost 来源；
# 只有显式设为 true 才放行（公网/远程部署不要打开）。scripts/demo.sh 会自动设。
# ALLOW_LOOPBACK_CORS=true
# 反向代理信任（ARCH-27）：nginx 反代后需要真实客户端 IP（限流/审计）时设 true
# TRUST_PROXY=false

# ---- 执行器鉴权 ----
# 所有执行器共享此密钥（生产要求 >= 16 字符）
EXECUTOR_SECRET=change_me_to_a_random_token_16chars

# ---- 任务密钥落库加密 (admin-api, SEC-02) ----
# tasks.secrets 的落库加密 key（32 字节 hex 或 base64，生成: openssl rand -hex 32）。
# 留空 = 任务密钥明文落库（启动时 warn 一次）；生产必须设置为强随机值并纳入
# 密钥备份（密钥丢失则密文 secrets 无法解密），详见 docs/deployment.md。
SEC_SECRETS_KEY=

# ---- 限流 (admin-api) ----
# 全局 API 限流（默认 60 次/分钟）；压测时建议调高（如 600）后重启 admin-api，
# 见 scripts/load-test.README.md
THROTTLE_LIMIT=60
THROTTLE_TTL=60000
# 总开关（false = 关闭全部限流，仅调试用）
# THROTTLE_ENABLED=true
# 登录接口限流（默认 20/分钟，生产建议 5）
LOGIN_THROTTLE_LIMIT=20
# 认证面（/api/auth/*，默认 10/60s）与运维面（/api/ops/*，默认 30/60s）独立档
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_AUTH_TTL=60000
# THROTTLE_OPS_LIMIT=30
# THROTTLE_OPS_TTL=60000

# 任务 webhook 触发端（POST /api/webhooks/tasks/:taskId）独立限流档
# （默认 60/分钟/IP；外部系统自动重试是正常流量，与人的操作面分账，FEAT-21）
# THROTTLE_WEBHOOK_LIMIT=60
# THROTTLE_WEBHOOK_TTL=60000

# 机器回调面独立档（SEC-09：不走人操作面的分域矩阵，按 IP 计）
# 执行器回调/心跳（默认 60/60s；多执行器同出口 IP（NAT）时按
# 「执行器数 × 批次数/分钟 × 安全系数」调高，QA-05）
# THROTTLE_CALLBACK_LIMIT=60
# THROTTLE_CALLBACK_TTL=60000
# 执行中日志增量上报（RT-LOG，默认 120/60s——必须高于全局默认 60：
# 按任务输出节奏触发，落到默认档会把话痨任务的日志限流截断）
# THROTTLE_LOG_STREAM_LIMIT=120
# THROTTLE_LOG_STREAM_TTL=60000
# 回调面 per-IP 硬顶（F1，2026-10-27 审计轮 #7；默认 12000 次/分钟/来源 IP）。
# 为什么还要这一层：上面的 60/60s 是按 x-executor-address 分桶的（B-2 为 NAT 后
# 多执行器而改），而该头**客户端可设**——换头即换桶，聚合速率因此没有上限，
# 而 /api/executions/callback 是全仓唯一 55MB 预认证 body 解析面。
# 这一层按来源 IP 计（与头无关），在 body 解析之前拒绝（429 + Retry-After）。
# 取值参考：100 台执行器 × 60/min = 6000/min，默认留 2 倍余量；多副本时每副本独立计数。
# CALLBACK_IP_CEILING_PER_MINUTE=12000

# ---- 调度 / 恢复 (admin-api) ----
# P2: stale sweep 兑现重试预算开关；false = 恢复旧行为（只置 FAILED 不重试）
STALE_RECOVERY_RETRY_ENABLED=true
# 注册指纹对账周期（F-1，HA 审计）：reload tick 每 N 轮做一次 DB 触发配置
# 与 Leader 本地注册表的指纹比对，漂移任务重排——多实例部署下任务更新请求
# 被 LB 打到 follower 时，Leader 上的旧 cron/fixed_rate/timezone 由对账自愈。
# 默认 5；0/负数/非整数按默认 5 处理（对账是自愈路径，无「关闭」语义）
# SCHEDULER_RECONCILE_EVERY=5
# SSRF 防护（F-3）：默认拦截回环/私网出站；admin-api 与执行器同机部署时必须设 true
# （admin-api 侧经根 compose 的 env_file 自动注入；两侧执行器不在 env_file 范围，
# 需独立部署时显式传入）
# SEC-NEW-2：executor-python 的 S7 gitRepo 守卫读取同名变量——true 时放行 RFC1918
# 内网 gitRepo（10/8、172.16/12、192.168/16），loopback（localhost/127.x）仍拒绝；
# 默认 false = 姿态不变。admin-api 侧 / executor-python 侧各自读取、语义对齐
EXECUTOR_ALLOW_PRIVATE_NETWORK=false

# ---- 执行器最低版本门禁 (admin-api，EXE-VER-1) ----
# 点分数字 1~4 段（如 1.3.0）；空（默认）= 关闭，零行为变化。
# 开启后：register 的 version 低于下限的执行器被拒绝注册（403，报文含升级指引）；
# 未上报 version 的存量执行器放行；heartbeat 响应回显 minVersion/versionCompliant，
# 执行器侧据此打版本漂移告警日志。
EXECUTOR_MIN_VERSION=

# ---- admin-api 侧执行器调度参数 (可选，默认与代码一致) ----
# 心跳活性评估周期（毫秒，默认 30000——与执行器自身的 HEARTBEAT_INTERVAL_SECONDS
# 分属两端：本键管 admin 侧判活/展示节奏，勿与执行器上报节奏混淆）
# EXECUTOR_HEARTBEAT_INTERVAL=30000
# 调度候选执行器池上限（F-07，默认 500；selectLeastLoaded/dispatch 的截断，
# 边缘计算数千台舰队可调大）
# EXECUTOR_CANDIDATE_POOL_SIZE=500
# 应用部署设备派发约束模式（FEAT-22，默认 prefer=软偏好可降级全机队；
# strict=存在显式部署行时收窄候选集、派不出去排队不换机——对存量任务是
# 硬约束，灰度路径见 docs）
# EXECUTOR_DEPLOYMENT_POLICY=prefer
# 心跳冲突自报的采信开关（默认 true，置 false 即回滚到旧行为）。
# 背景：容器化执行器重建后身份漂移会一直拿 409，而心跳仍在续命，导致被接管
# 窗口永不打开、部署永久在途。开启后 admin 侧采信执行器「我正处在注册冲突中」
# 的自报，停止用它的心跳供活性（活性判断交给指纹匹配的其余路径），让接管窗
# 正常打开。仅当自报**且**指纹错位时才生效——指纹匹配时不采信，防谎报存活。
# 设为 false 可整条链退回「心跳恒供活性」的旧语义（应急回滚，无需改代码）。
# EXECUTOR_HONOR_HEARTBEAT_CONFLICT_SELF_REPORT=true

# ---- 执行器 pull 派发模式 (ARCH-32，ADR-015) ----
# NAT 内执行器（无公网 IP/不可端口映射）零入站接入：执行器侧设
# EXECUTOR_PULL_MODE=true 并重启（重注册自动上报 dispatchMode=pull），
# 之后任务经长轮询 POST /executors/pull 取件，心跳/回调同为出站。
# 服务端两参数：wait=长轮询等待窗口（须 < 反代 60s 读超时）；ttl=队列载荷
# 过期丢弃阈值（执行器长期不拉取时由 stale sweep 收敛执行行）。
EXECUTOR_PULL_WAIT_MS=25000
EXECUTOR_PULL_TTL_MS=900000
# 执行器侧开关（executor-node / executor-python 各自读取；compose 默认未注入）
# EXECUTOR_PULL_MODE=false

# ---- 执行器回调签名 (admin-api + 两侧执行器) ----
# N23: per-execution 回调 token 的 HMAC 密钥（>=16 字符）；可选，缺省回落
# EXECUTOR_SECRET（两侧必须同源）。admin-api 侧经 env_file 注入；执行器侧
# compose 未注入 → 执行器仍自动回落共享 token
EXECUTION_CALLBACK_SECRET=

# ---- admin-web ----
# Nginx 反向代理中注入给前端的 API 地址
VITE_API_URL_INTERNAL=http://admin-api:3105
VITE_API_URL_EXTERNAL=
# E-34（DEEP_REVIEW 0ef3bbe）：REACT_APP_API_URL 已移除——admin-web 全部消费
# VITE_API_URL_*；compose 侧对该旧键仍有 ${REACT_APP_API_URL:-默认值} 兜底。

# ---- 执行器对外地址（docker-compose 形态**必填**；裸机/systemd 部署可不填）----
# P1-1（生产报告 2026-10-22 §3.1）：compose 里这两个键改成了 `${VAR:?}` 必填校验。
# 旧写法带了 :-executor-python:8001 / :-executor-node:8002 的缺省值，于是「没设
# 变量」的每个副本都上报**同一个**字面地址 → 中台看到「多份安装共享一个地址」
# （与 install.sh 取到 198.18.0.1 同型的碰撞制造机）。
# 单副本 dev 栈填 compose 内服务名即可；多副本/多机各填各自的局域网地址。
EXECUTOR_PYTHON_PUBLIC_ADDRESS=executor-python:8001
EXECUTOR_NODE_PUBLIC_ADDRESS=executor-node:8002

# ---- Admin API 访问地址 (可选) ----
ADMIN_API_URL_INTERNAL=http://admin-api:3105
ADMIN_API_URL_EXTERNAL=
# ADMIN_API_URL：admin-api **服务端**消费的对外基地址——「执行器 → 安装执行器」
# 向导生成的 install-cmd（GET /api/executors/install-cmd）与执行器包推送的
# 下载 URL 都用它拼接。与上面两个键不同：ADMIN_API_URL_INTERNAL/_EXTERNAL 是
# executor-node 侧回连 admin-api 用的客户端地址（compose 注入 http://admin-api:3105），
# 本键是 admin-api 生成对外命令/URL 时的自身基地址，二者不要混用。
# 留空 = 未配置（相关端点运行时 503 fail-fast）。单机部署填
# http://localhost:3105；跨机部署填执行器所在机器可达的地址
# （如 http://192.168.x.x:3105——compose 对 admin-api 端口是回环映射，
# 跨机可达需自行放开映射或走反向代理）。
ADMIN_API_URL=

# ---- 对外可达的 API 基地址 (APP-002，上传应用包时必需) ----
# 留空 = 走 compose 缺省 http://admin-api:3105（仅同 compose 网络内的执行器可达）。
# 有宿主/局域网/公网上的执行器（含桌面执行器）时，必须改成它们能访问的地址，
# 否则包上传时 packageUrl 不可达、执行器下载失败。
# 私网地址（192.168.x.x / 10.x.x.x）还需给执行器设 EXECUTOR_ALLOW_PRIVATE_NETWORK=true
# ——ssrf-guard 默认 fail-closed 会拒掉私网下载。
API_BASE_URL=

# ---- 私有包仓库 (可选) ----
# B-3（SEC-NEW）: NPM_REGISTRY_URL / PYPI_REGISTRY_URL 生产强制 https://，
# http 仅允许 localhost/127.0.0.1（本地 Verdaccio 默认 4873 / registry-pypi 默认 8003）。
# 不得在 URL 内嵌 user:pass 凭据——统一走下方 NPM_REGISTRY_USER/PASS 与 REGISTRY_PASS 独立键。
# B-2（私有包仓库域审计）：置空语义=回落官方源——compose 侧用 bash ${VAR-default}
# 语义（仅「未设置」才取私有源默认值），本文件的显式空串（`NPM_REGISTRY_URL=`）
# 会原样传给执行器并回落官方源（npmjs.com / pypi.org）。PYTHON_REGISTRY_URL 同族。
# 私有 npm registry（置空使用 npmjs.com；不设则用 compose 默认私有源 registry-npm:4873）
NPM_REGISTRY_URL=
# 私有 PyPI registry（置空使用 pypi.org；不设则用 compose 默认私有源 registry-pypi:8003）
# ⚠️ 这是**执行器侧**的 pip --index-url 语义（值带 `/simple/`）。admin-api 的
# 「包注册中心」列表代理用 `ADMIN_PYPI_REGISTRY_URL`（基址，不带 /simple/），
# 两者不能互换——共用会拼出 /simple//simple/（实测上游 404）。
PYPI_REGISTRY_URL=
# admin-api 视角的 PyPI registry 基址（不带 /simple/）。不设时 compose 给
# http://registry-pypi:8003；容器外部署需显式设为宿主机可达的地址。
ADMIN_PYPI_REGISTRY_URL=
# 生产环境 registry 出站强制 https（B-3）。compose 形态用的是内网服务名
# （http://registry-npm:4873），故需显式 opt-in；compose 默认 true。
# 容器外/公网部署请保持 false 或 https://。
REGISTRY_ALLOW_PRIVATE_NETWORK=
# 可选附加 PyPI 索引（私有源 + 官方源同时可见；--extra-index-url，执行器侧消费）
# PYPI_EXTRA_INDEX_URL=
# PYPI_REGISTRY_URL 的旧别名（执行器侧兼容读取，二者取一即可）
# PYTHON_REGISTRY_URL=
# zip 整包渠道（R5）下载体积上限（字节，默认 200MB，与 SSRF/下载链语义对齐）
# PACKAGE_DOWNLOAD_MAX_BYTES=209715200
# S5: npm registry 服务账号 / 预签发 token（registry-npm 对所有包要求认证，
# 不配置时 admin 的 npm 包列表为空）。token 优先于 user/pass。
# admin-api 侧经根 compose 的 env_file 注入；独立部署时需显式传入
NPM_REGISTRY_TOKEN=
NPM_REGISTRY_USER=
NPM_REGISTRY_PASS=
# S4/S5: registry 上传代理超时（毫秒，默认 60000，慢链路可调大）
REGISTRY_UPLOAD_TIMEOUT_MS=60000

# ---- PyPI registry 服务账号 (registry-pypi 服务用) ----
# E-34（DEEP_REVIEW 0ef3bbe）：PYPI_API_KEY 已移除——registry-pypi 只有 Basic Auth
# （REGISTRY_USER/PASS），该键从未被任何代码读取。
# P1（契约断裂修复，2026-10-25）：执行器侧凭据通道已补——设 PYPI_REGISTRY_USERNAME/
# PASSWORD（与 REGISTRY_USER/PASS 同值即可）后，执行器把它写成 0600 netrc，仅以
# NETRC env 键注入 uv install 子进程；凭据不进 argv/日志/URL。留空 = 无凭据通道
# （私有源匿名 401，与历史一致）；安装官方包可置空 PYPI_REGISTRY_URL 回落官方源，
# 或叠加 PYPI_EXTRA_INDEX_URL（见 docs/tutorials/02-private-registry-deps.md）。
PYPI_REGISTRY_USERNAME=
PYPI_REGISTRY_PASSWORD=
REGISTRY_USER=admin
REGISTRY_PASS=change_me

# ---- AI 集成 (可选) ----
# disabled | openai | ollama | qwen
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# openai 分支 max_tokens（F-6，默认 500 = 旧硬编码的失败日志分析省成本档；
# DB 系统设置页可进一步覆盖 env）
# OPENAI_MAX_TOKENS=500
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
# Qwen / DashScope（P1：多模态——文本 + 图片 + 视频理解）
# 走 DashScope 的 OpenAI 兼容端点，出站走与 openai 相同的 SSRF 守卫 + DNS pin。
# QWEN_MAX_TOKENS / QWEN_TIMEOUT_MS 刻意**独立于** openai 分支：
# 失败日志分析用 max_tokens=500 省成本，多模态推理与视频理解需求完全不同量级。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max
QWEN_MAX_TOKENS=4096
QWEN_TIMEOUT_MS=120000
# 视频转 SOP（可选）：视频理解要求模型能取到**直链**。
# AI_MEDIA_BASE_URL 必须是模型可达的地址（公网反代 / CDN / 对象存储），
# 不能是 localhost——签发出来的链接模型打不到，等于该功能不可用。
# AI_MEDIA_URL_SECRET 用于签发短时签名直链（HMAC-SHA256，>=16 字符）；
# 不配置时「视频转 SOP」如实不可用，其它 AI 能力不受影响。
AI_MEDIA_BASE_URL=
AI_MEDIA_URL_SECRET=
AI_MEDIA_URL_TTL_MS=3600000
# 保留期（推理质量轮）：上传素材与编写会话都会持续沉淀，必须有人清。
# 媒体按天清（磁盘 + DB 行，目录粒度）；会话按天清（只删行）。
AI_MEDIA_RETENTION_DAYS=7
AI_SESSION_RETENTION_DAYS=30
# ---- 中台 Agent（P2/P4，全部可选——不配置即用默认值，存量部署零变化）----
# 预算闸门（代码层强制，见 docs/design/agent-and-deployment/02 §5.3）
AGENT_BUDGET_MAX_STEPS=20
AGENT_BUDGET_MAX_TOKENS=200000
AGENT_BUDGET_WALL_CLOCK_MS=1800000
AGENT_BUDGET_MAX_TOOL_CALLS=50
# 上下文窗口（推理质量轮）：单次推理的估算 token 上限，超过即把早期对话折叠成
# 确定性摘要（原始步骤不删，模型可用 get_tool_call_result 回读）。调小=更早折叠；
# 换窗口更大的模型后可调大。MIN_RECENT_MESSAGES 是折叠时必须保留的最近消息条数
# （下限优先于上限：宁可略微超估算，也不折掉刚看到的工具结果）。
AGENT_CONTEXT_MAX_TOKENS=24000
AGENT_CONTEXT_MIN_RECENT_MESSAGES=12
# 触发器：事件先过聚合窗口（windowMs 内同类事件 ≥ threshold 才起一个 incident
# 会话），定时巡检每小时一次且仅 leader 实例执行
AGENT_TRIGGER_ENABLED=true
AGENT_TRIGGER_CRON_ENABLED=true
AGENT_TRIGGER_WINDOW_MS=300000
AGENT_TRIGGER_THRESHOLD=3
# 会话通知：成功且有结论→INFO / 失败或预算超限→ERROR / 待审批→WARNING；
# 无结论的巡检会话不通知（静默成功）。渠道本身在通知设置页配置。
AGENT_NOTIFY_ENABLED=true
# P6 协作面随 poll 下发的 SOP 策略（设计文档 11 §3.1）。执行器侧 P7 做
# min(本地, 中台) 合并；离线沿用最近一次缓存。
AGENT_SOP_POLICY=standard
AGENT_SOP_POLICY_ALLOWED=minimal,standard
# P6 超时治理（11 §6）：领取超时 / 进度心跳停滞阈值（毫秒）
SOP_ASSIGNMENT_CLAIM_TTL_MS=1800000
SOP_ASSIGNMENT_PROGRESS_TTL_MS=600000
# 澄清复核兜底（11 §6「澄清无人回 → 转人工」）：复核会话超此时长仍未答复 → escalated
SOP_CLARIFICATION_REVIEW_TTL_MS=1800000
# Agent 媒体（截图/录屏）保留天数（P7b 残差补齐；每日 03:15 清理）
AGENT_MEDIA_RETENTION_DAYS=7
# ARCH-31: AI 出站私网豁免。默认 false = SSRF 闸拒一切非 public 地址
# （本地 Ollama 的默认 localhost:11434 也被拒）；true 放行 loopback /
# restricted（198.18/15、100.64/10）/ private-LAN（10/8、172.16/12、192.168/16），
# 169.254.169.254 云元数据等 link-local 恒拒。同机自建 Ollama 部署需设 true。
AI_ALLOW_PRIVATE_NETWORK=false
# ARCH-31: 事件订阅 webhook 出站私网豁免（订阅创建/更新校验与 outbox 派发前
# 复核共用）。语义同上；注意事件订阅普通用户可建——开启即信任所有登录用户
# 可让平台向内网 endpoint 发签名 webhook，生产环境建议保持 false。
EVENT_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
# R17: 通知渠道（企业微信/钉钉/Slack/飞书/自定义 webhook 五渠道共用）出站
# 私网豁免——内网自建网关（内网 Alertmanager/IM 代理）需 true；云元数据恒拒
NOTIF_ALLOW_PRIVATE_NETWORK=false

# ---- OIDC SSO (AUTH-04, 可选) ----
# 授权码模式（confidential client）。默认 false = SSO 完全关闭，本地密码登录不受影响。
# 启用前在 IdP 注册回调地址：{API_BASE}/auth/oidc/callback
OIDC_ENABLED=false
# 如 https://sso.example.com/realms/autoflow（discovery URL 为 {issuer}/.well-known/openid-configuration）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 回调全 URL，须与 IdP 注册一致
OIDC_REDIRECT_URI=http://localhost:3105/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
# 用户名来源声明（sub 恒为身份绑定主键，不可更换）
OIDC_USERNAME_CLAIM=preferred_username
# 组→角色映射（R20，仅在 JIT 建号时生效；已绑定账号角色由平台管理员管理）：
# groups 声明名（默认 groups）+ 命中即授 ADMIN 的组清单（逗号分隔，空=一律 USER）
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
# JIT 自动建号：true 时未知用户首登自动创建 USER 账号；false（默认）仅允许
# 管理员预建同名账号后由首登绑定（更保守，推荐生产）
OIDC_AUTO_PROVISION=false
# 令牌颁发后浏览器落地的完整地址（#fragment 携带 token，不进服务器日志）
OIDC_WEB_REDIRECT_URL=http://localhost:5173/auth/sso/complete
# 同机/内网 IdP（如本机 Keycloak）需 true；云元数据段仍恒拒
OIDC_ALLOW_PRIVATE_NETWORK=false

# ---- 通知 — 企业微信 (可选) ----
WECOM_WEBHOOK=

# ---- 通知 — 钉钉 (可选) ----
DINGTALK_WEBHOOK=

# ---- 通知 — Slack (可选) ----
SLACK_WEBHOOK=

# ---- 通知 — 飞书自定义机器人 (可选, NF-05) ----
# open.feishu.cn 自定义机器人 webhook 地址；FEISHU_SECRET 为可选加签密钥
# （机器人开启「签名校验」时必须配置，留空 = 不加签模式）
FEISHU_WEBHOOK=
FEISHU_SECRET=

# ---- 通知 — 邮件 (可选) ----
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=autocodeflow@noreply.com
EMAIL_TO=

# ---- 通知 — 跨实例收敛 (admin-api, 可选) ----
# 渠道配置 / 通知静默的读穿刷新周期（毫秒，默认 15000）——多实例部署下
# 写穿 DB 后各实例按周期读穿，一个周期内跨实例收敛
# CHANNEL_CONFIG_REFRESH_MS=15000

# ---- 上传防护与病毒扫描 (SEC-05) ----
# zip 爆炸防护阈值（默认与原硬编码一致）：解压比 / 条目数 / 单文件字节 /
# 总解压字节 / 嵌套深度（积极探测层）/ 单层膨胀字节
# ZIP_MAX_RATIO=100
# ZIP_MAX_ENTRIES=10000
# ZIP_MAX_FILE_BYTES=536870912
# ZIP_MAX_TOTAL_BYTES=1073741824
# ZIP_MAX_NESTING_DEPTH=1
# ZIP_MAX_NESTED_INFLATE_BYTES=67108864
# 可选 clamd 病毒扫描（默认关闭）：CLAMD_ENABLED=true 时上传包流式 INSTREAM
# 送 ClamAV。失败策略 fail-closed——扫描服务不可达/超时一律拒绝上传；
# 启用前请确认 clamd 可达，否则上传通道整体拒绝。
# CLAMD_ENABLED=false
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=10000

# ---- 流推送 / 事件外发 / 任务操作面 (admin-api) ----
# SSE 并发流上限（防 fd 耗尽）：单执行默认 4、全局默认 64
# SSE_MAX_STREAMS_PER_EXECUTION=4
# SSE_MAX_STREAMS_GLOBAL=64
# Prometheus 指标流全局上限（默认 32）
# METRICS_STREAM_MAX_GLOBAL=32
# 事件订阅 outbox 派发开关（false = 只落库不派发）
# EVENT_OUTBOX_ENABLED=true
# 失败通知聚合窗口（分钟，默认 10）
# NOTIFICATION_FAILURE_DIGEST_MINUTES=10
# 任务操作面（默认 owner：仅 ADMIN 与任务相关人员可重试/取消；
# any = 回退旧宽松语义，任何已登录用户可操作）
# TASK_OPERATE_SCOPE=owner

# ---- 日志 ----
LOG_LEVEL=info
# 执行器工作目录 TTL 清理（executor-node 与 executor-python 两侧）
# 天数；node 侧 TTL 取 max(1, LOG_RETENTION_DAYS || 7)
LOG_RETENTION_DAYS=7
# execution_log_lines 按日分区清理路径开关（ARCH-22，默认 true=分区库走
# DETACH PARTITION + 每日预建；false 回退 legacy 分批 DELETE）
# LOG_PARTITION_ENABLED=true
# ---- 执行记录保留（task_executions，Q7 每日 02:00 cron）----
# ⚠️ **硬删除且不可逆**：到期行连同其执行日志与 S3 日志对象一并回收，
# **没有归档表**。需要留存的历史必须在到期前自行导出。
# 缺省 90 与硬编码时期行为逐字节一致；非法/非正数回退 90（绝不让配错把
# cutoff 推到未来而删空）。调大=占更多磁盘，调小=更早丢历史。
# TASK_EXECUTION_RETENTION_DAYS=90
# OpenTelemetry 分布式追踪开关（OBS-01，默认 false 零开销；true 时进程内
# span 树 + traceId 贯穿落库，不外发 exporter）
# OTEL_ENABLED=false

# ---- 执行器运行时 (两侧执行器) ----
# 任务工作目录根（默认 /tmp/autocodeflow/tasks；解释器缓存池默认在其兄弟目录，
# 必须与池物理隔离——WORK_DIR 会被 TTL 清扫）
# WORK_DIR=/tmp/autocodeflow/tasks
# 单任务超时（秒，默认 300）
# TASK_TIMEOUT_SECONDS=300
# 并发执行上限（默认 10，钳 1..10000；与心跳 runningExecutionIds 封顶同源）
# MAX_CONCURRENT_TASKS=10
# 心跳间隔秒（默认 30，钳 5..60；心跳被 admin 用于 stale 判定）
# HEARTBEAT_INTERVAL_SECONDS=30
# 执行器监听（默认 8001/8002；compose 按服务注入 PORT）
# BIND_ADDRESS=127.0.0.1
# 磁盘水位（默认 warn 90 / critical 95；critical 时 accept 阶段拒新任务）
# DISK_WARN_PERCENT=90
# DISK_CRITICAL_PERCENT=95

# ---- 任务沙箱与资源治理 (两侧执行器) ----
# TASK_SANDBOX：任务沙箱（F-1，两侧语义对齐）。空 = 直跑（默认）；
# bwrap = Linux 下 bubblewrap 只读 rootfs + user ns + tmpfs（--share-net 保持
# 外网可用）。推荐用 docker-compose.secure.yml 显式开启（镜像已含 bwrap；宿主
# 须允许非特权 user namespaces）。bwrap 不可用/非 Linux 时 fail-closed，
# 绝不静默降级——见 docs/deployment.md「容器安全（SEC-07）」。
TASK_SANDBOX=
# 任务进程内存上限（MB；node 侧 RSS 采样、python 侧 RLIMIT_AS；0=不限，默认 2048）
# TASK_MEMORY_LIMIT_MB=2048
# 打开文件描述符上限（ulimit -n，默认 1024；0=不设）
# TASK_NOFILE_LIMIT=1024
# CPU 秒数上限（RLIMIT_CPU；0=回落「任务超时+60s」）
# TASK_CPU_LIMIT_SECONDS=0
# 单文件大小上限 MB（python 侧 RLIMIT_FSIZE，默认 4096；node 不消费）
# TASK_FSIZE_LIMIT_MB=4096
# 进程数上限（python 侧 RLIMIT_NPROC，默认 0=不设；node 不消费）
# TASK_NPROC_LIMIT=0

# ---- 执行器安全/行为 (两侧执行器) ----
# S9: 执行器无 token 时拒绝 /api/* 请求（503，fail-closed）；compose 内已设 true
REQUIRE_TOKEN=true
# EXECUTOR_SECRET 的别名（执行器侧优先读它，二者取一即可；compose 注入前者）
# EXECUTOR_SHARED_TOKEN=

# ---- executor-python 磁盘清理 ----
# E8: 工作目录 TTL 回收（与 node 侧 file-logger 对齐；首次扫描延迟 10 分钟）
DISK_CLEANUP_TTL_DAYS=7
DISK_CLEANUP_INTERVAL_SECONDS=21600
DISK_CLEANUP_INITIAL_DELAY_SECONDS=600

# ---- 解释器缓存池（两侧执行器）----
# 体积红线（D12）：单版本/总池上限，超限告警 + 最久未使用回收（引用感知，
# 被 venv 依赖的版本绝不回收）
INTERPRETER_SINGLE_VERSION_MB=250
INTERPRETER_TOTAL_GB=4
# 下载全局有界并发（D13，默认 2；1 = 全局单队列；范围 [1,8]）
INTERPRETER_DOWNLOAD_CONCURRENCY=2
# 单次下载独立超时预算（秒，D11；默认 300）。桌面端设置页下发的是毫秒键
# INTERPRETER_DOWNLOAD_TIMEOUT_MS（优先于秒键）
# INTERPRETER_DOWNLOAD_TIMEOUT_SECONDS=300
# INTERPRETER_DOWNLOAD_TIMEOUT_MS=300000

# ---- Python 解释器版本区间（两侧执行器，CONTRACT.md §1.1）----
# 任务可声明的 X.Y 版本区间（默认 3.7~3.14，部署方可收紧；min 不得大于 max）
# PYTHON_RUNTIME_VERSION_MIN=3.7
# PYTHON_RUNTIME_VERSION_MAX=3.14
# uv 二进制显式覆盖（默认依次尝试 PATH 与 desktop 内置路径）
# UV_BIN=
# 解释器缓存池根目录（默认 workDir 的兄弟目录 interpreters；必须独立于 WORK_DIR）
# 解释器池内 uv 包缓存(.cache/.uv-cache)的 mtime 回收 TTL(天,默认 30,0=关闭;0 时仅按体积上限治理)
# 解释器池内 uv 包缓存的体积上限(MB,默认随实现;超限按 mtime 从旧到新回收)
# Prometheus 抓取 /api/metrics 的共享令牌(可选,恒时比较);设置后监控栈
# 的 prometheus.yml 用 authorization.credentials_file 提供同值文件
# METRICS_SCRAPER_TOKEN=
# UV_CACHE_MAX_MB=0
# UV_CACHE_TTL_DAYS=30
# UV_PYTHON_INSTALL_DIR=
# 解释器下载镜像（可选，D9 私有化内网源；http(s)、不带凭据）
# UV_PYTHON_INSTALL_MIRROR=

# ---- 执行日志存储 (LOG-02, compose 已接线) ----
# driver=db 时日志行存 execution_log_lines；driver=s3 时每条执行一个 gzip
# 对象存 MinIO/S3（需先启动 minio profile），详见 docs/operations.md
LOG_STORAGE_DRIVER=db
LOG_STORAGE_BUCKET=autoflow-logs
LOG_STORAGE_ENDPOINT=minio:9000
LOG_STORAGE_ACCESS_KEY=autoflow
LOG_STORAGE_SECRET_KEY=
LOG_STORAGE_USE_SSL=false
# S3 region（MinIO 部署无需；真实 AWS S3 按桶所在 region 填写）
# LOG_STORAGE_REGION=

# ---- MinIO (profile: minio，compose 已接线) ----
# 启用 s3 日志存储时必须设置（MINIO_ROOT_PASSWORD 无默认值，缺失则容器启动失败）
MINIO_ROOT_USER=autoflow
MINIO_ROOT_PASSWORD=

# ---- PostgreSQL 定时备份 (profile: backup，M-1) ----
# 启用: docker compose --profile backup up -d pg-backup
# busybox crond 格式；默认每日 02:00，保留 30 天
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ---- 监控 (profile: monitoring，M-3/M-4) ----
# 启用: docker compose --profile monitoring up -d
# NETOPT-4：Grafana 管理口令无弱缺省（compose 侧 :? 强制注入），复制本文件
# 为 .env 后必须设置真实强口令，否则 monitoring profile 起不来。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password

# ---- 初始管理员账号 (首次部署) ----
# 登录邮箱（默认 admin@autoflow.local）
# INITIAL_ADMIN_EMAIL=admin@autoflow.local
# 占位值与其他密钥占位一致：原样复制到生产（NODE_ENV=production）会被
# fail-fast 拒绝启动（E-03，configuration.ts 弱值校验 + compose 已移除缺省
# 口令）——首次部署务必改成自己随机生成的强口令（>=8 字符，如
# `openssl rand -base64 18`）。未设置（注释掉本行）则跳过初始管理员种子
# （不创建 admin 账号）；开发环境（NODE_ENV≠production）可用占位值启动。
INITIAL_ADMIN_PASSWORD=change_me_immediately

# ---- 健康检查阈值 (admin-api, WIKI-OPT-1) ----
# GET /api/health 判定阈值与全量响应缓存；默认与原硬编码一致，行为不变
# 队列积压 degraded 阈值（failed / delayed / waiting 计数上限）
HEALTH_QUEUE_FAILED_MAX=100
HEALTH_QUEUE_DELAYED_MAX=500
HEALTH_QUEUE_WAITING_MAX=1000
# 执行器在线比例下限（0~1，低于则 degraded）
HEALTH_EXECUTOR_ONLINE_RATIO_MIN=0.5
# 全量健康响应短 TTL 缓存窗口（毫秒；0=关闭，默认关闭；live/ready 探针不受影响）
HEALTH_CACHE_TTL_MS=0
# 公开（免登录）健康摘要的缓存窗口（毫秒，默认 5000）
# HEALTH_PUBLIC_CACHE_TTL_MS=5000
# 磁盘 / 堆水位（PLAN-OBSERVABILITY §5.1）：只进需鉴权的 /health/detailed，
# 不进 /health/ready（就绪探针只管核心依赖）。盘满后新执行的日志/产物写入
# 会失败、堆耗尽会被 OOM kill，两者此前都表现为"健康检查全绿"。
# 阈值单位 %；degraded 与 unhealthy 两档，默认与 alerts.yml 保守起点一致。
# HEALTH_DISK_USAGE_DEGRADED_PERCENT=85
# HEALTH_DISK_USAGE_UNHEALTHY_PERCENT=95
# HEALTH_HEAP_USED_DEGRADED_PERCENT=85
# HEALTH_HEAP_USED_UNHEALTHY_PERCENT=95
# 磁盘探测路径（默认进程 cwd，即 admin-api 日志与上传产物的落盘处）
# HEALTH_DISK_CHECK_PATH=/app

# ---- 慢查询日志 (admin-api, PERF-1) ----
# 单条 SQL 执行耗时超过该毫秒数时记一条 warn（TypeORM maxQueryExecutionTime，
# 含完整 SQL 文本 + 参数数组；与其他 warn 同形）。默认 1000ms——只捞真正值得
# 看的慢查询；0 = 关闭。与 DB_LOGGING 无关：development 下逐条打 SQL，生产
# 恒关，而慢查询恰是生产最需要的信号，故单独一个键。
# 上限 600000（10 分钟），再大等于静默关闭。
# DB_SLOW_QUERY_MS=1000

# ---- SystemConfig 读缓存 (admin-api, PERF-2 / PLAN-BACKEND-ARCHITECTURE §4.2) ----
# 配置读面（findOne）的进程内短 TTL 缓存窗口（毫秒）。默认 1000——一秒内
# 合并重复读，人工改配置后最多 1s 可见；0 = 关闭（回到每次读库）。
# 写入（upsert / 批量 / 删除 / 回滚）恒失效**本实例**缓存，并 PUBLISH 到
# Redis 频道 config:system-config:evict——其他实例毫秒级逐出，故多实例部署下
# 改完配置全集群立即可见（无需等 TTL）。Redis 不可用时广播被吞、不影响写入，
# 语义退回「其他实例最多滞后一个 TTL 窗口」。
# 需要连 TTL 窗口都不接受（强一致）时置 0——缓存整体关闭，广播随之 no-op。
# 上限 60000（60s）。
# SYSTEM_CONFIG_CACHE_TTL_MS=1000

# ---- 执行器设备事实扫描 TTL (executor-node, R3/§4.3) ----
# 心跳 deployedApps/installedPackages 两份设备事实的扫描缓存 TTL（秒）。
# 两份事实同一心跳载荷、同写面主动失效模式（部署成功/manifest 落盘即失效），
# 共用一个旋钮。默认 60；下限 5、上限 600（越界钳制）。
# DEPLOYED_APPS_SCAN_TTL_SECONDS=60

# ---- 执行器应用 releases 版本组保留数 (executor-node, 5c/§9.7) ----
# releases/ 历史按**版本组**裁剪：保留 current 指向的组 + 最新 N-1 个组
# （组内部署目录全保）。这是 KEEP_RELEASES=5（5 个 release 目录）的继任
# 语义——按版本组织后，同版本多部署不再各占一个保留位。默认 3；
# 非法值回落默认，最终钳到 [1,50]。
# EXECUTOR_KEEP_VERSIONS=3

# ---- 执行器 zip 包字节缓存预算 (executor-node/python, R5b/§4.5-5b) ----
# .pkg-cache 的字节预算，超限按 mtime 淘汰最旧；默认 4GiB。**0 = 显式关闭
# 缓存**（不读不写，行为与无缓存时代一致）；负数按 0 处理。两侧同名同义
# （python 侧见 Settings.pkg_cache_max_bytes）。
# PKG_CACHE_MAX_BYTES=4294967296
